#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
  #text(size: 30pt, weight: "bold")[Brüche subtrahieren]
  #v(40pt)

  #only("1-")[Übung: Subtrahiere 2/5 von 4/5]
  #v(20pt)

  #only("2-")[Schritt 1: Bestimme die Brüche]
  #v(10pt)
  #only("3-")[- Minuend: 4/5]
  #only("4-")[- Subtrahend: 2/5]

  #only("1")[
    #voiceover("Leider ist das nicht korrekt. Lass uns Schritt für Schritt durch die Lösung gehen, um zu verstehen, warum 2/5 die richtige Antwort ist.")
  ]

  #only("2")[
    #voiceover("Zuerst identifizieren wir die Brüche, mit denen wir in diesem Subtraktionsproblem arbeiten.")
  ]

  #only("3")[
    #voiceover("Der Minuend, also die Zahl, von der wir subtrahieren, ist vier Fünftel.")
  ]

  #only("4")[
    #voiceover("Der Subtrahend, also die Zahl, die wir subtrahieren, ist zwei Fünftel.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Der Subtraktionsprozess]
  #v(40pt)

  #only("1-")[Schritt 2: Überprüfe die Nenner]
  #v(10pt)
  #only("2-")[- Beide Brüche haben den Nenner 5]
  #only("3-")[- Kein gemeinsamer Nenner erforderlich]
  
  #only("4-")[Schritt 3: Subtrahiere die Zähler]
  #v(10pt)
  #only("5-")[$ 4 - 2 = 2 $]

  #only("1")[
    #voiceover("Nun schauen wir uns den Subtraktionsprozess an.")
  ]

  #only("2")[
    #voiceover("Wir überprüfen zuerst die Nenner unserer Brüche. In diesem Fall haben beide Brüche den Nenner 5.")
  ]

  #only("3")[
    #voiceover("Das bedeutet, wir müssen keinen gemeinsamen Nenner finden, was unser Problem vereinfacht.")
  ]

  #only("4")[
    #voiceover("Der nächste Schritt ist, die Zähler zu subtrahieren.")
  ]

  #only("5")[
    #voiceover("Vier minus zwei ergibt zwei.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Das Endergebnis]
  #v(40pt)

  #only("1-")[Schritt 4: Schreibe das Ergebnis]
  #v(20pt)
  #only("2-")[$ 4/5 - 2/5 = 2/5 $]
  
  #only("3-")[✅ Die Antwort ist korrekt!]

  #only("1")[
    #voiceover("Nun können wir unser Endergebnis schreiben.")
  ]

  #only("2")[
    #voiceover("Vier Fünftel minus zwei Fünftel ergibt zwei Fünftel.")
  ]

  #only("3")[
    #voiceover("Und da haben wir es! Du hast diese Brüche korrekt subtrahiert. Denke daran, dass wir beim Subtrahieren von Brüchen mit demselben Nenner den Nenner gleich lassen und einfach die Zähler subtrahieren. Großartige Arbeit bei der Lösung dieses Problems!")
  ]
]