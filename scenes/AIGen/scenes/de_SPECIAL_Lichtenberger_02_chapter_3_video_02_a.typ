#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: es => [
#set text(size: 20pt)
#es.body
]

#slide()[

#only("1")[
#voiceover("Ausgezeichnet! Du hast absolut recht. Lass uns die Begründung Schritt für Schritt durchgehen.")
]

#text(size: 30pt, weight: "bold")[Ballonphysik 🎈]

#v(40pt)

#only("2-")[- Auftriebskraft 🔼 vs. Gewicht ⏬]
// Das Konzept der Auftriebskraft vs. Gewicht wird ab Folie 2 gezeigt

#only("2")[
#voiceover("Damit der Ballon in einer konstanten Höhe schwebt, muss ein Gleichgewicht zwischen zwei Kräften bestehen: der nach oben gerichteten Auftriebskraft und dem nach unten gerichteten Gewicht des Ballons.")
]

]

#slide()[

#text(size: 30pt, weight: "bold")[Bedingung zum Schweben ⏸]

#v(40pt)

#only("1-")[- Auftriebskraft = Gewicht]

#v(10pt)

#only("2-")[#align(center)[#text(fill:aqua)[⇓ Mathematisch]]]

#v(10pt)

#only("3-")[$ F_"Auftrieb" = F_"Gewicht" $]

#only("1")[#voiceover("Die Bedingung zum Schweben ist, dass die Auftriebskraft gleich dem Gewicht des Ballons sein muss.")]

#only("2")[#voiceover("Wir können dies mathematisch ausdrücken.")]

#only("3")[#voiceover("Die Auftriebskraft, F sub Auftrieb, muss gleich der Gewichtskraft, F sub Gewicht, sein.")]

]

#slide()[

#text(size: 30pt, weight: "bold")[Auftriebskraft 🔼]

#v(40pt)

#only("1-")[- Hängt vom Volumen der verdrängten Luft ab 🌬]
// Die Abhängigkeit der Auftriebskraft vom verdrängten Luftvolumen wird ab Folie 1 gezeigt

#v(10pt)

#only("2-")[- Steigt mit dem Ballonvolumen 📈]
// Die Beziehung zwischen Auftriebskraft und Ballonvolumen wird ab Folie 2 gezeigt

#only("1")[#voiceover("Die Auftriebskraft hängt vom Volumen der vom Ballon verdrängten Luft ab. Es ist die nach oben gerichtete Kraft, die die Luft auf den Ballon ausübt.")]

#only("2")[#voiceover("Wenn das Volumen des Ballons zunimmt, verdrängt er mehr Luft, und somit steigt die Auftriebskraft.")]

]

#slide()[

#text(size: 30pt, weight: "bold")[Gewichtskraft ⏬]

#v(40pt)

#only("1-")[- Hängt von der Masse des Ballons ab 🪨]
// Die Abhängigkeit der Gewichtskraft von der Ballonmasse wird ab Folie 1 gezeigt

#v(10pt)

#only("2-")[- Konstant für einen gegebenen Ballon 📏]
// Die Konstanz der Gewichtskraft für einen gegebenen Ballon wird ab Folie 2 gezeigt

#only("1")[#voiceover("Die Gewichtskraft hingegen hängt von der Masse des Ballons ab, einschließlich des Gases im Inneren.")]

#only("2")[#voiceover("Für einen gegebenen Ballon ist die Gewichtskraft konstant, da sich die Masse nicht ändert.")]

]

#slide()[

#text(size: 30pt, weight: "bold")[Zusammenfassung 📝]

#v(40pt)

#only("1-")[- Auftriebskraft 🔼 = Gewichtskraft ⏬]
// Die Bedingung zum Schweben wird ab Folie 1 wiederholt

#v(10pt)

#only("2-")[- Erreicht durch Anpassung des Ballonvolumens 🎈📏]
// Die Methode zum Erreichen des Schwebens wird ab Folie 2 gezeigt

#only("1")[#voiceover("Zusammenfassend muss die Auftriebskraft gleich der Gewichtskraft sein, damit der Ballon schwebt.")]

#only("2")[#voiceover("Diese Bedingung wird durch die Anpassung des Volumens des Ballons erreicht. Wenn das Volumen so ist, dass die Auftriebskraft das Gewicht ausgleicht, wird der Ballon in einer konstanten Höhe schweben.")]

]