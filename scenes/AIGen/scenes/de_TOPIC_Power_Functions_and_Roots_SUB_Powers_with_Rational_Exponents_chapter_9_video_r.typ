#slide()[
#text(size: 30pt, weight: "bold")[Rationale Exponenten Rückblick 📝]
#v(40pt)
#only("1-")[- Rationale Exponenten repräsentieren Wurzeln 🌱]
#v(20pt)
#only("2-")[- $a^(m/n) = root(n, a^m)$ ✅]
#v(20pt)
#only("3-")[- Vereinfachen, multiplizieren, dividieren, Gleichungen lösen 🧮]
#only("1")[
#voiceover("In diesem Kapitel haben wir gelernt, dass rationale Exponenten eine andere Möglichkeit sind, Wurzeln darzustellen.")
]
#only("2")[
#voiceover("Der Ausdruck a hoch m durch n ist gleich der n-te Wurzel von a hoch m.")
]
#only("3")[
#voiceover("Wir können Ausdrücke mit rationalen Exponenten vereinfachen, multiplizieren und dividieren sowie Gleichungen mit ihnen lösen, indem wir spezifische Regeln anwenden.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Vereinfachen von rationalen Exponenten 🔍]
#v(40pt)
#only("1-")[- Zwischen rationalem Exponenten und Wurzelform umwandeln]
#v(20pt)
#only("2-")[- Beispiel: $8^(1/3) = 2$ 🎯]
#only("1")[
#voiceover("Um Ausdrücke mit rationalen Exponenten zu vereinfachen, können wir sie in die Wurzelform umwandeln und umgekehrt.")
]
#only("2")[
#voiceover("Zum Beispiel vereinfacht sich 8 hoch ein Drittel zu 2, weil die dritte Wurzel von 8 gleich 2 ist.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Multiplizieren und Dividieren 🧮]
#v(40pt)
#only("1-")[- Multiplizieren: $a^(m/n) a^(p/q) = a^((m/n) + (p/q))$]
#v(20pt)
#only("2-")[- Dividieren: $a^(m/n) / a^(p/q) = a^((m/n) - (p/q))$]
#only("1")[
#voiceover("Beim Multiplizieren von Ausdrücken mit rationalen Exponenten addieren wir die Exponenten und vereinfachen.")
]
#only("2")[
#voiceover("Beim Dividieren subtrahieren wir die Exponenten und vereinfachen.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Gleichungen lösen 🔢]
#v(40pt)
#only("1-")[- Den Term mit dem Exponenten isolieren]
#v(20pt)
#only("2-")[- Beide Seiten auf den Kehrwert des Exponenten potenzieren]
#v(20pt)
#only("3-")[- Beispiel: $x^(1/2) = 4 arrow x = 16$ 🎉]
#only("1")[
#voiceover("Um Gleichungen mit rationalen Exponenten zu lösen, isolieren wir zuerst den Term mit dem Exponenten.")
]
#only("2")[
#voiceover("Dann potenzieren wir beide Seiten der Gleichung auf den Kehrwert des Exponenten.")
]
#only("3")[
#voiceover("Zum Beispiel, wenn x hoch ein Halb gleich 4 ist, dann ist x gleich 16, weil das Quadrat von 4 gleich 16 ist.")
]
]

