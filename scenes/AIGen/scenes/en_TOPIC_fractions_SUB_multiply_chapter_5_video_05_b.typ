#slide()[
#text(size: 30pt, weight: "bold")[Real-World Applications of Multiplying Fractions]
#v(40pt)
#text(size: 20pt, weight: "bold")[Exercise: You have $2/3$ of a pie, and you give $3/4$ of it to your neighbor. How much of the whole pie did your neighbor get?]
#v(20pt)
#only("1-")[- a) $1/2$]
#only("2-")[- b) $1/4$]
#only("3-")[- c) $1/3$]
#only("4-")[- d) $1/6$]
#v(40pt)
#only("1")[#voiceover("Not quite, but no worries! Let's go through the correct solution step-by-step.")]
#only("2")[#voiceover("First, let's look at option a) one-half. To find out if this is correct, we need to multiply two-thirds by three-fourths.")]
#only("3")[#voiceover("Next, let's consider option b) one-fourth. Is this the correct answer? Let's see by multiplying two-thirds by three-fourths.")]
#only("4")[#voiceover("Now, let's examine option c) one-third. Again, we need to multiply two-thirds by three-fourths to find out.")]
#only("5")[#voiceover("Finally, let's check option d) one-sixth. We will multiply two-thirds by three-fourths to determine if this is correct.")]
]


#slide()[
#text(size: 30pt, weight: "bold")[Solution]
#v(40pt)
#only("1-")[- Multiply $2/3$ by $3/4$]
#v(20pt)
#only("2-")[- $2/3 dot 3/4 = (2 dot 3)/(3 dot 4)$]
#v(20pt)
#only("3-")[- $= 6/12$]
#v(20pt)
#only("4-")[- $= 1/2$]
#v(40pt)
#only("1")[#voiceover("To find out how much of the whole pie your neighbor got, we need to multiply two-thirds by three-fourths.")]
#only("2")[#voiceover("We multiply the numerators together and the denominators together. So, two times three over three times four.")]
#only("3")[#voiceover("This gives us six over twelve.")]
#only("4")[#voiceover("Simplifying six over twelve, we get one-half. So, the correct answer is a) one-half.")]
]


#slide()[
#text(size: 30pt, weight: "bold")[Why Other Options Are Incorrect]
#v(40pt)
#only("1-")[- Option b) $1/4$]
#v(10pt)
