#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]

#slide()[
#text(size: 30pt, weight: "bold")[Schwimmplattform-Material]
#v(40pt)
#only("1-")[Welches Material eignet sich am besten für den Bau einer Schwimmplattform?]
#v(40pt)
// Von Anfang bis Abschnitt eins ist die Option schwarz. Ab Abschnitt 2 bis zum Ende wird sie dann rot, weil sie falsch ist.
#only("-1")[a) Holz]#only("2-")[#text(fill:red)[a) Holz]]
#v(10pt)
// Von Anfang bis Abschnitt zwei ist die Option schwarz. Ab Abschnitt 3 bis zum Ende wird sie dann rot, weil sie falsch ist.
#only("-2")[b) Beton]#only("3-")[#text(fill:red)[b) Beton]]
#v(10pt)
// Von Anfang bis Abschnitt drei ist die Option schwarz. Ab Abschnitt 4 bis zum Ende wird sie dann rot, weil sie falsch ist.
#only("-3")[c) Stahl]#only("4-")[#text(fill:red)[c) Stahl]]
#v(10pt)
// Von Anfang bis Abschnitt vier ist die Option schwarz. Ab Abschnitt 5 bis zum Ende wird sie dann grün, weil sie richtig ist.
#only("-4")[d) Schaumstoff]#only("5-")[#text(fill:green)[d) Schaumstoff]]
#v(40pt)

#only("1")[#voiceover("Leider nicht ganz richtig. Das beste Material für den Bau einer Schwimmplattform ist tatsächlich Schaumstoff.")]
// Sehr kurz über a sprechen und warum es falsch ist
#only("2")[#voiceover("Holz kann zwar schwimmen, ist aber keine gute Wahl, da es im Laufe der Zeit Wasser aufnimmt, was zu Fäulnis führen und die Integrität der Plattform beeinträchtigen kann.")]
// Sehr kurz über b sprechen und warum es falsch ist
#only("3")[#voiceover("Beton ist viel zu dicht und schwer, um für eine Schwimmplattform verwendet zu werden. Es würde sinken statt schwimmen.")]
// Sehr kurz über c sprechen und warum es falsch ist
#only("4")[#voiceover("Stahl ist wie Beton auch zu dicht, um allein für eine Schwimmplattform verwendet zu werden. Es würde erhebliche zusätzliche Auftriebshilfen benötigen, um zu schwimmen.")]
// Sehr kurz über d sprechen und warum es richtig ist
#only("5")[#voiceover("Schaumstoff, insbesondere geschlossenzelliger Schaumstoff, ist die beste Wahl. Er ist leicht, wasserabweisend und bietet hervorragenden Auftrieb. Viele Schwimmdocks und Plattformen verwenden Schaumstoffkerne aus diesen Gründen.")]
]

#slide()[
#text(size: 30pt, weight: "bold")[Warum Schaumstoff? 🤔]
#v(40pt)
#only("1-")[- Leicht 🪶]
#v(20pt)
#only("2-")[- Wasserabweisend 💧]
#v(20pt)
#only("3-")[- Hervorragender Auftrieb 🎈]
#v(20pt)
#only("4-")[- Langlebig 💪]
#v(20pt)
#only("5-")[- Leicht zu formen und zu bearbeiten 🔧]

#only("1")[#voiceover("Lass uns etwas tiefer darauf eingehen, warum Schaumstoff die beste Wahl für eine Schwimmplattform ist.")]
#only("2")[#voiceover("Erstens ist Schaumstoff, insbesondere geschlossenzelliger Schaumstoff, hochgradig wasserabweisend. Er nimmt kein Wasser auf wie Holz oder andere poröse Materialien.")]
#only("3")[#voiceover("Schaumstoff bietet auch hervorragenden Auftrieb. Seine geringe Dichte und die Tatsache, dass er mit Gasblasen gefüllt ist, bedeuten, dass er relativ zu seiner eigenen Masse viel Gewicht tragen kann.")]
#only("4")[#voiceover("Trotz seines geringen Gewichts kann Schaumstoff sehr langlebig sein. Viele Schaumstoffarten, wie hochdichtes Polyethylen, sind widerstandsfähig gegen Stöße, Chemikalien und UV-Licht.")]
#only("5")[#voiceover("Schließlich ist Schaumstoff leicht zu formen und zu bearbeiten. Er kann geschnitten, gebohrt und in verschiedene Formen gebracht werden, was ihn anpassungsfähig für unterschiedliche Plattformdesigns macht.")]
]

#slide()[
#text(size: 30pt, weight: "bold")[Anwendungen in der Praxis 🌎]
#v(40pt)
#only("1-")[- Schwimmdocks 🛳️]
#v(20pt)
#only("2-")[- Pontonboote 🚤]
#v(20pt)
#only("3-")[- Auftriebshilfen im Wassersport 🏄‍♂️]
#v(20pt)
#only("4-")[- Schwimmende Wasserparks 🏝️]

#only("1")[#voiceover("Schaumstoff wird in der Praxis häufig für schwimmende Strukturen verwendet.")]
#only("2")[#voiceover("Viele Pontonboote verwenden schaumgefüllte Röhren oder Stämme, um Auftrieb zu bieten. Der Schaumstoff sorgt dafür, dass das Boot auch dann schwimmt, wenn die äußere Hülle beschädigt ist.")]
#only("3")[#voiceover("Im Wassersport wird Schaumstoff in Schwimmwesten, Kickboards und anderen Auftriebshilfen verwendet. Seine Fähigkeit zu schwimmen und sein geringes Gewicht machen ihn perfekt für diese Anwendungen.")]
#only("4")[#voiceover("Sogar große Strukturen wie schwimmende Wasserparks verwenden oft Schaumstoffblöcke oder -module als Basis. Der Schaumstoff bietet den notwendigen Auftrieb, um den Park stabil und über Wasser zu halten.")]
]

#slide()[
#text(size: 30pt, weight: "bold")[Zusammenfassung]
#v(40pt)
#only("1-")[- Schaumstoff ist das beste Material für Schwimmplattformen 🌟]
#v(20pt)
#only("2-")[- Er ist leicht, wasserabweisend und bietet hervorragenden Auftrieb 👍]
#v(20pt)
#only("3-")[- Schaumstoff ist langlebig und leicht zu bearbeiten 🔧]
#v(20pt)
#only("4-")[- Er wird häufig in Schwimmdocks, Booten und im Wassersport verwendet 🌊]

#only("1")[#voiceover("Zusammenfassend lässt sich sagen, dass Schaumstoff tatsächlich das beste Material für den Bau einer Schwimmplattform ist.")]
#only("2")[#voiceover("Seine einzigartigen Eigenschaften - leicht, wasserabweisend und hervorragender Auftrieb - machen ihn ideal für schwimmende Strukturen.")]
#only("3")[#voiceover("Darüber hinaus ist Schaumstoff langlebig und leicht zu bearbeiten, was es ermöglicht, ihn an verschiedene Designs anzupassen.")]
#only("4")[#voiceover("Diese Vorteile haben dazu geführt, dass Schaumstoff in einer Vielzahl von praktischen Anwendungen weit verbreitet ist, von kleinen Auftriebshilfen bis hin zu großen schwimmenden Strukturen. Gut gemacht, dass Du die richtige Antwort gefunden hast!")]
]