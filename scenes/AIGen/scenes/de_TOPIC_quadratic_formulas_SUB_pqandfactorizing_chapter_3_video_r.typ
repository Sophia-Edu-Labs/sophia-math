#slide()[
#text(size: 30pt, weight: "bold")[Die p-q-Formel: Ein kurzer Rückblick 📝]
#v(40pt)
#only("1-")[Allgemeine Form: $a x^2 + b x + c = 0$]
#v(20pt)
#only("2-")[p-q-Form: $x^2 + p x + q = 0$]
#v(20pt)
#only("3-")[p-q-Formel: $x_(1,2) = -p/2 plus.minus sqrt((p/2)^2 - q)$]

#only("1")[
#voiceover("Lass uns die p-q-Formel kurz wiederholen. Wir beginnen mit der allgemeinen Form einer quadratischen Gleichung: a x Quadrat plus b x plus c gleich null.")
]
#only("2")[
#voiceover("Dann wandeln wir sie in die p-q-Form um: x Quadrat plus p x plus q gleich null.")
]
#only("3")[
#voiceover("Das ergibt die p-q-Formel: x Index 1,2 gleich minus p durch 2, plus oder minus die Quadratwurzel von p durch 2 zum Quadrat minus q.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Beispiel: Eine quadratische Gleichung lösen 🎯]
#v(40pt)
#only("1-")[Gleichung: $x^2 - 6x + 5 = 0$]
#v(20pt)
#only("2-")[Identifizieren: $p = -6$, $q = 5$]
#v(20pt)
#only("3-")[Anwenden: $x_(1,2) = -(-6)/2 plus.minus sqrt(((-6)/2)^2 - 5)$]
#v(20pt)
#only("4-")[Vereinfachen: $x_(1,2) = 3 plus.minus sqrt(9 - 5) = 3 plus.minus 2$]
#v(20pt)
#only("5-")[Lösungen: $x_1 = 5$, $x_2 = 1$]

#only("1")[
#voiceover("Lass uns die Gleichung x Quadrat minus 6x plus 5 gleich null lösen.")
]
#only("2")[
#voiceover("Zuerst identifizieren wir p und q. Hier ist p gleich minus 6 und q gleich 5.")
]
#only("3")[
#voiceover("Jetzt wenden wir die p-q-Formel an: x Index 1,2 gleich minus minus 6 durch 2, plus oder minus die Quadratwurzel von minus 6 durch 2 zum Quadrat minus 5.")
]
#only("4")[
#voiceover("Vereinfacht ergibt das x Index 1,2 gleich 3 plus oder minus die Quadratwurzel von 9 minus 5, was 3 plus oder minus 2 ist.")
]
#only("5")[
#voiceover("Das ergibt unsere Lösungen: x Index 1 gleich 5 und x Index 2 gleich 1.")
]
]


#slide()[
