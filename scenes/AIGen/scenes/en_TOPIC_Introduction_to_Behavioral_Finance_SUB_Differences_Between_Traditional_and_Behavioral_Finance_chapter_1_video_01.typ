#slide()[
#text(size: 30pt, weight: "bold")[Behavioral Finance 🧠💰]
#v(40pt)
#only("1-")[- Studies how psychology affects financial decisions and markets]
#only("1")[
#voiceover("Behavioral finance is a field that studies how psychological factors influence financial decisions and market outcomes.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Traditional vs. Behavioral Finance]
#v(40pt)
#only("1-")[- Traditional finance: Investors are rational 🤖]
#v(20pt)
#only("2-")[- Behavioral finance: Investors are influenced by emotions and biases 😀😟]
#only("1")[
#voiceover("Traditional finance assumes that investors are rational and always make decisions based on logic and reason.")
]
#only("2")[
#voiceover("However, behavioral finance recognizes that investors are human and can be influenced by emotions, biases, and other psychological factors.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Psychological Factors 🧠]
#v(40pt)
#only("1-")[- Emotions: Fear, greed, hope 😨😋🤞]
#v(20pt)
#only("2-")[- Biases: Overconfidence, loss aversion, anchoring 😎😱⚓]
#only("1")[
#voiceover("Emotions such as fear, greed, and hope can play a significant role in how investors make decisions.")
]
#only("2")[
#voiceover("Additionally, cognitive biases like overconfidence, loss aversion, and anchoring can lead to irrational behavior and suboptimal investment choices.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Impact on Financial Decisions 💸]
#v(40pt)
#only("1-")[- Investors may buy or sell based on emotions rather than facts 📈📉]
#v(20pt)
#only("2-")[- Biases can lead to poor risk assessment and portfolio management 🎲📊]
#only("1")[
#voiceover("These psychological factors can cause investors to buy or sell assets based on emotions rather than objective facts and analysis.")
]
#only("2")[
#voiceover("Biases can also lead to poor risk assessment and suboptimal portfolio management, resulting in lower returns or higher losses.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Market Outcomes 📊]
#v(40pt)
#only("1-")[- Investor behavior can create market inefficiencies 📉📈]
#v(20pt)
#only("2-")[- Examples: Bubbles, crashes, and mispricing of assets 🫧💥💰]
#only("1")[
#voiceover("When many investors are influenced by the same psychological factors, their collective behavior can create market inefficiencies.")
]
#only("2")[
#voiceover("This can lead to phenomena such as bubbles, crashes, and the mispricing of assets, which deviate from the assumptions of traditional finance.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Summary]
#v(40pt)
#only("1-")[- Behavioral finance studies the impact of psychology on financial decisions and markets 🧠💰📊]
#v(20pt)
#only("2-")[- Emotions and biases can lead to irrational behavior and market inefficiencies 😀😟📉📈]
#v(20pt)
#only("3-")[- Understanding behavioral finance can help investors make better decisions 🤔💡]
#only("1")[
#voiceover("In summary, behavioral finance studies how psychological factors like emotions and biases affect financial decisions and market outcomes.")
]
#only("2")[
#voiceover("These factors can lead to irrational investor behavior and create market inefficiencies, such as bubbles, crashes, and mispricing of assets.")
]
#only("3")[
#voiceover("By understanding the principles of behavioral finance, investors can become more aware of their own psychological biases and make better-informed decisions in the face of market uncertainty.")
]
