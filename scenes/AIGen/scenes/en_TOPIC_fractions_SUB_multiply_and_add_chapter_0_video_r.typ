#slide()[
  #text(size: 30pt, weight: "bold")[Example: Multiplying Fractions]
  #v(40pt)
  #only("1-")[
    #align(center)[
      $ (2/3) dot (3/4) = ? $
    ]
  ]
  #v(20pt)
  #only("2-")[1️⃣ Multiply numerators: $2 dot 3 = 6$]
  #v(20pt)
  #only("3-")[2️⃣ Multiply denominators: $3 dot 4 = 12$]
  #v(20pt)
  #only("4-")[3️⃣ Combine: $(2/3) dot (3/4) = 6/12$]
  #v(20pt)
  #only("5-")[4️⃣ Simplify: $6/12 = 1/2$]
  
  #only("1")[
    #voiceover("Let's work through an example. Say we want to multiply two-thirds by three-fourths.")
  ]
  #only("2")[
    #voiceover("First, we multiply the numerators: 2 times 3 equals 6.")
  ]
  #only("3")[
    #voiceover("Then, we multiply the denominators: 3 times 4 equals 12.")
  ]
  #only("4")[
    #voiceover("Combining these, we get 6 over 12.")
  ]
  #only("5")[
    #voiceover("Finally, we can simplify this to one-half.")
  ]
]


