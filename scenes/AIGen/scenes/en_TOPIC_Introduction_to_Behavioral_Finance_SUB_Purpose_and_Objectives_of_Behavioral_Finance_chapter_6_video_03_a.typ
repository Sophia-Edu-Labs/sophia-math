#slide()[
#text(size: 30pt, weight: "bold")[Efficient Market Hypothesis]
#v(40pt)
#only("1-")[- Key concept in Traditional Finance 🔑]
#v(20pt)
#only("2-")[- Prices reflect all available information 📈]
#v(20pt)
