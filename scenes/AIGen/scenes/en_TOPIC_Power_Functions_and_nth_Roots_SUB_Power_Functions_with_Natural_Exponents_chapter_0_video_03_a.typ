#only("1-")[- What is the value of $2^3$? 🤔]
#only("1")[
#voiceover("The problem asks us to find the value of two raised to the power of three.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Step-by-Step Solution]
#v(40pt)
#only("1-")[- Power function: $a^b$]
#v(20pt)
#only("2-")[- Base: $a$]
#v(20pt)
#only("3-")[- Exponent: $b$]
#v(20pt)
#only("4-")[- $2^3$ means $2 \cdot 2 \cdot 2$]
#v(20pt)
#only("5-")[- $2 \cdot 2 = 4$]
#v(20pt)
#only("6-")[- $4 \cdot 2 = 8$]
#only("1")[
#voiceover("First, let's understand what a power function is. A power function is written as a raised to the power of b.")
]
#only("2")[
#voiceover("In this expression, a is called the base.")
]
#only("3")[
#voiceover("And b is called the exponent.")
]
#only("4")[
#voiceover("So, $2^3$ means we multiply the base 2 by itself three times.")
]
#only("5")[
#voiceover("First, we multiply 2 by 2, which equals 4.")
]
#only("6")[
#voiceover("Then, we multiply 4 by 2, which equals 8.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Final Answer]
#v(40pt)
#only("1-")[- $2^3 = 8$ 🎉]
#only("1")[
#voiceover("So, the value of $2^3$ is 8. Well done!")
]
]