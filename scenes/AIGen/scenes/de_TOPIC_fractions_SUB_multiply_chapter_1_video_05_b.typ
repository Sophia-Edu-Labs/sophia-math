#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
#text(size: 30pt, weight: "bold")[Brüche multiplizieren]
#v(40pt)
#only("1-")[- Übung: Multipliziere $5/6$ mit $6/7$.]
#v(20pt)
#only("2-")[- Option a) $30/42$]
#only("3-")[- Option b) $36/42$]
#only("4-")[- Option c) $42/42$]
#only("5-")[- Option d) $30/36$]
#v(20pt)
#only("6-")[- Richtige Antwort: $30/42$ oder $5/7$]
#only("1")[#voiceover("Keine Sorge, dass war ein guter Versuch! Lass uns die Lösung Schritt für Schritt durchgehen.")]
#only("2")[#voiceover("Option a) ist 30/42. Lass uns sehen, ob das korrekt ist.")]
#only("3")[#voiceover("Option b) ist 36/42. Lass uns auch diese überprüfen.")]
#only("4")[#voiceover("Option c) ist 42/42. Wir werden auch diese überprüfen.")]
#only("5")[#voiceover("Option d) ist 30/36. Auch diese werden wir überprüfen.")]
#only("6")[#voiceover("Die richtige Antwort ist Option a) 30/42, was sich zu 5/7 vereinfacht.")]
]


#slide()[
#text(size: 30pt, weight: "bold")[Schritt-für-Schritt-Lösung]
#v(40pt)
#only("1-")[- Multipliziere die Zähler: $5 dot 6$]
#only("2-")[- Multipliziere die Nenner: $6 dot 7$]
#only("3-")[- Ergebnis: $30/42$]
#only("4-")[- Vereinfachen: $30/42 = 5/7$]
#v(20pt)
#only("1")[#voiceover("Zuerst multiplizieren wir die Zähler. Also, 5 mal 6 ergibt 30.")]
#only("2")[#voiceover("Als nächstes multiplizieren wir die Nenner. Also, 6 mal 7 ergibt 42.")]
#only("3")[#voiceover("Das ergibt den Bruch 30/42.")]
#only("4")[#voiceover("Schließlich vereinfachen wir den Bruch 30/42 zu 5/7.")]
]


#slide()[
#text(size: 30pt, weight: "bold")[Warum andere Optionen falsch sind]
#v(40pt)
#only("1-")[- Option b) $36/42$: Falsch, weil $5 dot 6$ nicht $36$ ist]
#only("2-")[- Option c) $42/42$: Falsch, weil $5 dot 6$ nicht $42$ ist]
#only("3-")[- Option d) $30/36$: Falsch, weil $6 dot 7$ nicht $36$ ist]
#v(20pt)
#only("1")[#voiceover("Option b) 36/42 ist falsch, weil 5 mal 6 nicht 36 ist.")]
#only("2")[#voiceover("Option c) 42/42 ist falsch, weil 5 mal 6 nicht 42 ist.")]
#only("3")[#voiceover("Option d) 30/36 ist falsch, weil 6 mal 7 nicht 36 ist.")]
]


#slide()[
#text(size: 30pt, weight: "bold")[Vereinfachung]
#v(40pt)
#only("1-")[- Vereinfache $30/42$ zu $5/7$]
#v(20pt)
#only("1")[#voiceover("Um 30/42 zu vereinfachen, teilen wir sowohl den Zähler als auch den Nenner durch ihren größten gemeinsamen Teiler, der 6 ist. Das ergibt 5/7.")]
]