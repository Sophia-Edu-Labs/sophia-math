#slide()[
#text(size: 30pt, weight: "bold")[Hicks Decomposition Recap 🎓]
#v(40pt)
#only("1-")[- Separates price change effects into substitution and income effects]
#only("1")[
#voiceover("In this recap, we'll revisit the key points of Hicks Decomposition. Hicks Decomposition separates the effects of a price change into substitution and income effects.")
]
#v(20pt)
#only("2-")[- Holds utility constant 📈]
#only("2")[
#voiceover("A key aspect of Hicks Decomposition is that it holds utility constant when analyzing these effects.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Substitution Effect 🔄]
#v(40pt)
#only("1-")[- Shows how consumption changes when price changes, keeping utility constant]
#only("1")[
#voiceover("The substitution effect in Hicks Decomposition shows how consumption changes when the price changes, while keeping utility constant.")
]
#v(20pt)
#only("2-")[- If price decreases, quantity demanded increases]
#only("2")[
#voiceover("If the price of a good decreases, the quantity demanded of that good will increase due to the substitution effect.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Income Effect 💰]
#v(40pt)
#only("1-")[- Shows how consumption changes due to change in real income, after adjusting for substitution effect]
#only("1")[
#voiceover("The income effect in Hicks Decomposition shows how consumption changes due to a change in real income, after adjusting for the substitution effect.")
]
#v(20pt)
#only("2-")[- If price decreases, real income increases]
#only("2")[
#voiceover("If the price of a good decreases, the consumer's real income will increase.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Mathematical Representation 📜]
#v(40pt)
#only("1-")[- Uses compensated demand functions]
#only("1")[
#voiceover("Hicks Decomposition uses compensated demand functions to mathematically represent the substitution and income effects of a price change.")
]
#v(20pt)
#only("2-")[- Compensated demand function: $h_X(p_X, p_Y, U)$]
#only("2")[
#voiceover("The compensated demand function for a good X is written as h sub X of p sub X, p sub Y, and U, where p sub X and p sub Y are the prices of goods X and Y, and U is the utility level.")
]
]

