]
#v(40pt)
#only("4-")[
$ = (9)/(4) = 9/4 $
// The final result is shown from slide 4 onward
#only("4")[
#voiceover("27 raised to the power of two thirds is 9, and 8 raised to the power of two thirds is 4. So the simplified result is 9 over 4.")
]
]
