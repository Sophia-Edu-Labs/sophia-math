]


#slide()[
  #text(size: 30pt, weight: "bold")[Subtracting Fractions]
  #v(40pt)

  #only("1-")[Exercise: Subtract 2/5 from 4/5]
  #v(20pt)

  #only("2-")[Step 1: Identify the fractions]
  #v(10pt)
  #only("3-")[- Minuend: 4/5]
  #only("4-")[- Subtrahend: 2/5]

  #only("1")[
    #voiceover("Not quite. Let's walk through the solution step-by-step to understand why 2/5 is the correct answer.")
  ]

  #only("2")[
    #voiceover("First, let's identify the fractions we're working with in this subtraction problem.")
  ]

  #only("3")[
    #voiceover("The minuend, which is the number we're subtracting from, is four-fifths.")
  ]

  #only("4")[
    #voiceover("The subtrahend, which is the number we're subtracting, is two-fifths.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[The Subtraction Process]
  #v(40pt)

  #only("1-")[Step 2: Check the denominators]
  #v(10pt)
  #only("2-")[- Both fractions have denominator 5]
  #only("3-")[- No need to find a common denominator]
  
  #only("4-")[Step 3: Subtract the numerators]
  #v(10pt)
  #only("5-")[$ 4 - 2 = 2 $]

  #only("1")[
    #voiceover("Now, let's look at the subtraction process.")
  ]

  #only("2")[
    #voiceover("We first check the denominators of our fractions. In this case, both fractions have a denominator of 5.")
  ]

  #only("3")[
    #voiceover("This means we don't need to find a common denominator, which simplifies our problem.")
  ]

  #only("4")[
    #voiceover("The next step is to subtract the numerators.")
  ]

  #only("5")[
    #voiceover("Four minus two equals two.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[The Final Result]
  #v(40pt)

  #only("1-")[Step 4: Write the result]
  #v(20pt)
  #only("2-")[$ 4/5 - 2/5 = 2/5 $]
  
  #only("3-")[✅ The answer is correct!]

  #only("1")[
    #voiceover("Now we can write our final result.")
  ]

  #only("2")[
    #voiceover("Four-fifths minus two-fifths equals two-fifths.")
  ]

  #only("3")[
    #voiceover("And there we have it! You've correctly subtracted these fractions. Remember, when subtracting fractions with the same denominator, we keep the denominator the same and simply subtract the numerators. Great work on solving this problem!")
  ]
]