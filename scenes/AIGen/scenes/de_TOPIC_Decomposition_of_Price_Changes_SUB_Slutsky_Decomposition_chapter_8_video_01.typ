#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]

#slide()[
#text(size: 30pt, weight: "bold")[Slutsky vs Hicks Zerlegung]
#v(40pt)
#only("1-")[- Beide zerlegen die Effekte einer Preisänderung 💰]
#v(20pt)
#only("2-")[- Slutsky: Hält das reale Einkommen konstant 🏦]
#v(20pt)
#only("3-")[- Hicks: Hält den Nutzen konstant 😊]
#only("1")[
#voiceover("Slutsky-Zerlegung und Hicks-Zerlegung sind zwei Methoden, um die Effekte einer Preisänderung zu zerlegen.")
]
#only("2")[
#voiceover("Der Hauptunterschied ist, dass die Slutsky-Zerlegung das reale Einkommen konstant hält.")
]
#only("3")[
#voiceover("Andererseits hält die Hicks-Zerlegung den Nutzen konstant.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Slutsky Zerlegung]
// Der Titel "Slutsky Zerlegung" wird auf dieser Folie angezeigt
#v(40pt)
#only("1-")[- Reales Einkommen konstant 🏦]
// Der Punkt, dass Slutsky das reale Einkommen konstant hält, wird ab Folie 1 angezeigt
#v(20pt)
#only("2-")[- Kompensiert durch Einkommenseffekt 💸]
// Der Punkt, dass der Verbraucher bei Slutsky durch den Einkommenseffekt kompensiert wird, wird ab Folie 2 angezeigt
#v(20pt)
#only("3-")[- Fokussiert auf Substitutionseffekt 🔄]
// Der Punkt, dass Slutsky sich auf den Substitutionseffekt konzentriert, wird ab Folie 3 angezeigt
#only("1")[
#voiceover("Bei der Slutsky-Zerlegung wird das reale Einkommen des Verbrauchers konstant gehalten.")
]
#only("2")[
#voiceover("Das bedeutet, dass der Verbraucher für den Einkommenseffekt der Preisänderung kompensiert wird.")
]
#only("3")[
#voiceover("Infolgedessen isoliert und fokussiert die Slutsky-Zerlegung den Substitutionseffekt.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Hicks Zerlegung]
// Der Titel "Hicks Zerlegung" wird auf dieser Folie angezeigt
#v(40pt)
#only("1-")[- Nutzen konstant 😊]
// Der Punkt, dass Hicks den Nutzen konstant hält, wird ab Folie 1 angezeigt
#v(20pt)
#only("2-")[- Kompensiert durch Substitutionseffekt 🔄]
// Der Punkt, dass der Verbraucher bei Hicks durch den Substitutionseffekt kompensiert wird, wird ab Folie 2 angezeigt
#v(20pt)
#only("3-")[- Fokussiert auf Einkommenseffekt 💸]
// Der Punkt, dass Hicks sich auf den Einkommenseffekt konzentriert, wird ab Folie 3 angezeigt
#only("1")[
#voiceover("Im Gegensatz dazu hält die Hicks-Zerlegung den Nutzen des Verbrauchers konstant.")
]
#only("2")[
#voiceover("Das bedeutet, dass der Verbraucher für den Substitutionseffekt der Preisänderung kompensiert wird.")
]
#only("3")[
#voiceover("Folglich isoliert und fokussiert die Hicks-Zerlegung den Einkommenseffekt.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Zusammenfassung]
#v(40pt)
#only("1-")[- Slutsky: Reales Einkommen konstant, fokussiert auf Substitutionseffekt]
#v(20pt)
#only("2-")[- Hicks: Nutzen konstant, fokussiert auf Einkommenseffekt]
#v(20pt)
#only("3-")[- Beide zerlegen die Effekte einer Preisänderung, aber unterschiedlich]
#only("1")[
#voiceover("Zusammenfassend hält die Slutsky-Zerlegung das reale Einkommen konstant und fokussiert auf den Substitutionseffekt.")
]
#only("2")[
#voiceover("Die Hicks-Zerlegung hingegen hält den Nutzen konstant und fokussiert auf den Einkommenseffekt.")
]
#only("3")[
#voiceover("Während beide Methoden die Effekte einer Preisänderung zerlegen, tun sie dies auf unterschiedliche Weise und bieten jeweils eine einzigartige Perspektive auf das Verbraucherverhalten.")
]
]