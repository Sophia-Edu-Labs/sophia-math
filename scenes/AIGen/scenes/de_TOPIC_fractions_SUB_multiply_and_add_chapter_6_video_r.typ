#slide()[
  #text(size: 30pt, weight: "bold")[Der Prozess 📊]
  #v(40pt)
  #only("1-")[1. Einen gemeinsamen Nenner finden 🔍]
  #v(20pt)
  #only("2-")[2. Brüche in gleichwertige Brüche umwandeln 🔄]
  #v(20pt)
  #only("3-")[3. Die Zähler addieren ➕]
  #v(20pt)
  #only("4-")[4. Falls möglich, vereinfachen ✂️]

  #only("1")[
    #voiceover("Der erste Schritt beim Addieren von Brüchen ist, einen gemeinsamen Nenner zu finden. Das ist wichtig, weil wir Brüche nur addieren können, wenn sie den gleichen Nenner haben.")
  ]
  #only("2")[
    #voiceover("Als nächstes wandeln wir jeden Bruch in einen gleichwertigen Bruch mit diesem gemeinsamen Nenner um. Denke daran, dass gleichwertige Brüche denselben Wert darstellen.")
  ]
  #only("3")[
    #voiceover("Sobald wir Brüche mit demselben Nenner haben, können wir die Zähler addieren, während der Nenner gleich bleibt.")
  ]
  #only("4")[
    #voiceover("Schließlich, falls möglich, vereinfachen wir den resultierenden Bruch, indem wir sowohl den Zähler als auch den Nenner durch ihren größten gemeinsamen Teiler teilen.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Beispiel 🌟]
  #v(40pt)
  #only("1-")[Das Addieren von $1/3$ und $1/4$]
  #v(20pt)
  #only("2-")[Gemeinsamer Nenner: $12$]
  #v(20pt)
  #only("3-")[$1/3 = 4/12$ und $1/4 = 3/12$]
  #v(20pt)
  #only("4-")[$4/12 + 3/12 = 7/12$]

  #only("1")[
    #voiceover("Lass uns ein Beispiel durchgehen. Angenommen, wir wollen ein Drittel und ein Viertel addieren.")
  ]
  #only("2")[
    #voiceover("Zuerst müssen wir einen gemeinsamen Nenner finden. Das kleinste gemeinsame Vielfache von 3 und 4 ist 12, also verwenden wir 12 als unseren gemeinsamen Nenner.")
  ]
  #only("3")[
    #voiceover("Nun wandeln wir jeden Bruch in einen gleichwertigen Bruch mit dem Nenner 12 um. Ein Drittel wird zu vier Zwölfteln und ein Viertel wird zu drei Zwölfteln.")
  ]
  #only("4")[
    #voiceover("Schließlich addieren wir die Zähler: vier Zwölftel plus drei Zwölftel ergibt sieben Zwölftel. Dieser Bruch kann nicht weiter vereinfacht werden, also ist das unser Endergebnis.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Zusammenfassung 📝]
  #v(40pt)
  #only("1-")[- Ein gemeinsamer Nenner ist entscheidend 🔑]
  #only("2-")[- In gleichwertige Brüche umwandeln ↔️]
  #only("3-")[- Zähler addieren, Nenner beibehalten ➕]
  #only("4-")[- Falls möglich, vereinfachen 🔍]

  #only("1")[
    #voiceover("Zusammenfassend, denke daran, dass das Finden eines gemeinsamen Nenners der Schlüssel zum Addieren von Brüchen ist.")
  ]
  #only("2")[
    #voiceover("Wandle deine Brüche immer in gleichwertige Brüche mit diesem gemeinsamen Nenner um.")
  ]
  #only("3")[
    #voiceover("Dann addiere die Zähler, während der Nenner gleich bleibt.")
  ]
  #only("4")[
    #voiceover("Schließlich, vereinfache dein Ergebnis, falls möglich. Mit diesen Schritten wirst du Brüche sicher addieren können!")
  ]
]