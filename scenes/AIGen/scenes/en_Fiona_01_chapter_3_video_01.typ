#slide()[
#text(size: 30pt, weight: "bold")[Introduction to Absolute and Relative Frequency]
#v(40pt)
#only("1-")[- Imagine you are a doctor analyzing patient data 📊]
#v(20pt)
#only("2-")[- You need to understand how often certain conditions occur]
#v(20pt)
#only("3-")[- This is where absolute and relative frequencies come in]
#only("1")[
#voiceover("Imagine you are a doctor analyzing patient data. You need to understand how often certain conditions occur. This is where absolute and relative frequencies come in.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Absolute Frequency]
#v(40pt)
#only("1-")[- Absolute frequency: The total count of occurrences]
#v(20pt)
#only("2-")[- Example: 20 patients have diabetes out of 100 patients]
#v(20pt)
#only("3-")[- Absolute frequency of diabetes is 20]
#only("1")[
#voiceover("Absolute frequency is the total count of occurrences. For example, if 20 patients have diabetes out of 100 patients, the absolute frequency of diabetes is 20.")
]
#only("2")[
#voiceover("So, in our example, the absolute frequency of diabetes is 20.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Relative Frequency]
#v(40pt)
#only("1-")[- Relative frequency: The proportion of occurrences]
#v(20pt)
#only("2-")[- Calculated as: (absolute frequency) / (total number of observations)]
#v(20pt)
#only("3-")[- Example: Relative frequency of diabetes is $20 / 100 = 0.2$ or 20%]
#only("1")[
#voiceover("Relative frequency is the proportion of occurrences. It is calculated as the absolute frequency divided by the total number of observations.")
]
#only("2")[
#voiceover("For example, the relative frequency of diabetes is 20 divided by 100, which equals 0.2 or 20 percent.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Summary]
#v(40pt)
#only("1-")[- Absolute frequency: Total count of occurrences]
#v(20pt)
#only("2-")[- Relative frequency: Proportion of occurrences]
#v(20pt)
#only("3-")[- Example: 20 patients with diabetes out of 100 patients]
#v(20pt)
#only("4-")[- Relative frequency: $20 / 100 = 0.2$ or 20%]
#only("1")[
#voiceover("In summary, absolute frequency is the total count of occurrences, while relative frequency is the proportion of occurrences.")
]
#only("2")[
#voiceover("For example, if 20 patients have diabetes out of 100 patients, the absolute frequency is 20.")
]
#only("3")[
#voiceover("And the relative frequency is 20 divided by 100, which equals 0.2 or 20 percent.")
]
]