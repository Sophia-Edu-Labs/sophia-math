#it.body
]


#slide()[
#text(size: 30pt, weight: "bold")[Introduction to Absolute and Relative Frequency]
#v(40pt)
#only("1-")[- Imagine you are drawing cards from a deck 🎴]
#v(20pt)
#only("2-")[- How often does each card appear? 🃏]
#v(20pt)
#only("3-")[- How can we describe this data? 📊]
#only("1")[
#voiceover("Imagine you are drawing cards from a deck. This is a common situation where we need to understand frequencies.")
]
#only("2")[
#voiceover("How often does each card appear? This is where the concept of absolute frequency comes in.")
]
#only("3")[
#voiceover("We can describe this data using absolute and relative frequencies.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Absolute Frequency]
#v(40pt)
#only("1-")[- Absolute frequency: Count of occurrences of a specific event 🔢]
#v(20pt)
#only("2-")[- Example: Drawing a heart from a deck of cards]
#v(20pt)
#only("3-")[- If you draw 5 hearts in 10 draws, absolute frequency is 5]
#only("1")[
#voiceover("Absolute frequency is the count of occurrences of a specific event.")
]
#only("2")[
#voiceover("For example, consider drawing a heart from a deck of cards.")
]
#only("3")[
#voiceover("If you draw 5 hearts in 10 draws, the absolute frequency of drawing a heart is 5.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Relative Frequency]
#v(40pt)
#only("1-")[- Relative frequency: Ratio of the absolute frequency to the total number of events ➗]
#v(20pt)
#only("2-")[- Example: Drawing a heart from a deck of cards]
#v(20pt)
#only("3-")[- If you draw 5 hearts in 10 draws, relative frequency is $5/10 = 0.5$]
#only("1")[
#voiceover("Relative frequency is the ratio of the absolute frequency to the total number of events.")
]
#only("2")[
#voiceover("For example, consider drawing a heart from a deck of cards.")
]
#only("3")[
#voiceover("If you draw 5 hearts in 10 draws, the relative frequency of drawing a heart is 5 divided by 10, which equals 0.5.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Summary]
#v(40pt)
#only("1-")[- Absolute frequency: Count of occurrences of a specific event 🔢]
#v(20pt)
#only("2-")[- Relative frequency: Ratio of the absolute frequency to the total number of events ➗]
#v(20pt)
#only("3-")[- Example: Drawing a heart from a deck of cards]
#only("4-")[- Absolute frequency: 5, Relative frequency: $5/10 = 0.5$]
#only("1")[
#voiceover("In summary, absolute frequency is the count of occurrences of a specific event.")
]
#only("2")[
#voiceover("Relative frequency is the ratio of the absolute frequency to the total number of events.")
]
#only("3")[
#voiceover("For example, when drawing a heart from a deck of cards, if you draw 5 hearts in 10 draws, the absolute frequency is 5.")
]
#only("4")[
#voiceover("And the relative frequency is 5 divided by 10, which equals 0.5.")
]
]