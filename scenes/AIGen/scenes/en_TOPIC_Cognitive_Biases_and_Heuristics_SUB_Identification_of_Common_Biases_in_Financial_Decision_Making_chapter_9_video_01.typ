#slide()[
#text(size: 30pt, weight: "bold")[Availability Heuristic 🧠]
#v(40pt)
#only("1-")[- Mental shortcut for estimating likelihood 🤔]
#only("1")[
#voiceover("The availability heuristic is a mental shortcut that we use to estimate the likelihood or frequency of an event.")
]
#v(20pt)
#only("2-")[- Based on ease of recall 📝]
#only("2")[
#voiceover("It relies on the ease with which examples or instances come to mind.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[How It Works 🛠]
#v(40pt)
#only("1-")[- Memorable events seem more likely 💡]
#only("1")[
#voiceover("Events that are more easily remembered or recalled are judged to be more likely or frequent than events that are less easily remembered.")
]
#v(20pt)
#only("2-")[- Vivid or recent events are more available 🌟]
#only("2")[
#voiceover("This is because vivid, unusual, or emotionally charged events are more available in our memory. Recent events are also more easily remembered.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Example 🌴]
#v(40pt)
#only("1-")[- Overestimating risk of shark attacks 🦈]
#only("1")[
#voiceover("For example, after seeing a news report about a shark attack, people may overestimate the likelihood of being attacked by a shark when swimming in the ocean.")
]
#v(20pt)
#only("2-")[- Actual risk is very low 📊]
#only("2")[
#voiceover("In reality, the risk of a shark attack is very low. But the vivid and dramatic nature of the event makes it more available in memory, leading to an inflated perception of risk.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Impact on Decisions 🎯]
#v(40pt)
#only("1-")[- Overestimating likelihood leads to biased decisions 📉]
#only("1")[
#voiceover("The availability heuristic can lead to biased decisions because it causes us to overestimate the likelihood of events that are easily remembered.")
]
#v(20pt)
#only("2-")[- Neglecting actual probabilities 🎲]
#only("2")[
#voiceover("This can cause us to make decisions based on our perceived likelihood of an event, rather than the actual probability of the event occurring.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Summary 🎬]
#v(40pt)
#only("1-")[- Availability heuristic: estimating likelihood based on ease of recall 🧠]
#only("1")[
#voiceover("In summary, the availability heuristic is a mental shortcut where we estimate the likelihood of an event based on how easily examples come to mind.")
]
#v(20pt)
#only("2-")[- Leads to overestimating memorable events 💭]
#only("2")[
#voiceover("This can lead us to overestimate the likelihood of vivid, recent, or emotionally charged events.")
]
#v(20pt)
#only("3-")[- Can result in biased decisions 🎯]
#only("3")[
#voiceover("As a result, the availability heuristic can lead to biased decisions that are based on our perceived likelihood of an event, rather than the actual probability.")
]
]