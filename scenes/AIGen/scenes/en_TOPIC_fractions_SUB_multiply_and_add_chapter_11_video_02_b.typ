#it.body
]


#slide()[
  #text(size: 30pt, weight: "bold")[Subtracting Fractions]
  #v(40pt)

  #only("1-")[Exercise: Subtract 3/10 from 7/10]
  #v(20pt)

  #only("2-")[Step 1: Identify the fractions]
  #v(10pt)
  #only("3-")[- Minuend: 7/10]
  #only("4-")[- Subtrahend: 3/10]

  #only("1")[
    #voiceover("Let's review the correct solution step by step to understand how we subtract fractions.")
  ]

  #only("2")[
    #voiceover("First, let's identify the problem. We need to subtract three-tenths from seven-tenths.")
  ]

  #only("3")[
    #voiceover("The minuend, which is the number we're subtracting from, is seven-tenths.")
  ]

  #only("4")[
    #voiceover("The subtrahend, which is the number we're subtracting, is three-tenths.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[The Subtraction Process]
  #v(40pt)

  #only("1-")[Step 2: Check the denominators]
  #v(10pt)
  #only("2-")[- Both fractions have denominator 10]
  #only("3-")[- No need to find a common denominator]
  #v(20pt)
  #only("4-")[Step 3: Subtract the numerators]
  #v(10pt)
  #only("5-")[$ 7/10 - 3/10 = (7-3)/10 = 4/10 $]

  #only("1")[
    #voiceover("Now, let's look at the subtraction process.")
  ]

  #only("2")[
    #voiceover("First, we check the denominators. In this case, both fractions have a denominator of ten.")
  ]

  #only("3")[
    #voiceover("This is great because it means we don't need to find a common denominator. We can subtract directly.")
  ]

  #only("4")[
    #voiceover("To subtract fractions with the same denominator, we simply subtract the numerators and keep the denominator the same.")
  ]

  #only("5")[
    #voiceover("So, we have seven-tenths minus three-tenths, which equals seven minus three, over ten. This gives us four-tenths.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Simplifying the Result]
  #v(40pt)

  #only("1-")[Step 4: Simplify if possible]
  #v(10pt)
  #only("2-")[$ 4/10 = 2/5 $]
  #v(20pt)
  #only("3-")[Final answer: 4/10 or 2/5]

  #only("1")[
    #voiceover("Our last step is to check if we can simplify our result.")
  ]

  #only("2")[
    #voiceover("Four-tenths can be simplified by dividing both the numerator and denominator by their greatest common factor, which is 2. This gives us two-fifths.")
  ]

  #only("3")[
    #voiceover("Therefore, our final answer is four-tenths, which can also be written as two-fifths. Both forms are correct!")
  ]
]