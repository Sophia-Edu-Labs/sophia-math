#slide()[
  #text(size: 30pt, weight: "bold")[The Conversion Process 🔄]
  #v(40pt)
  #only("1-")[1. Identify the fraction ✅]
  #only("2-")[2. Find equivalent fraction with denominator 10, 100, 1000, etc. 🔍]
  #only("3-")[3. Perform the division ➗]
  #only("4-")[4. Write as a decimal 📝]

  #only("1")[
    #voiceover("The first step in our conversion process is to identify the fraction we want to convert.")
  ]
  #only("2")[
    #voiceover("Next, we find an equivalent fraction with a denominator that's a power of ten - like 10, 100, or 1000. This is the key step that makes the conversion easier.")
  ]
  #only("3")[
    #voiceover("Then, we perform the division indicated by the fraction.")
  ]
  #only("4")[
    #voiceover("Finally, we write the result as a decimal.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Example: Converting 3/4 to a Decimal 🧮]
  #v(20pt)
  #only("1-")[Step 1: Identify the fraction]
  #only("1-")[$3/4$]
  #v(10pt)
  #only("2-")[Step 2: Find equivalent fraction]
  #only("2-")[$3/4 = (3 * 25)/(4 * 25) = 75/100$]
  #v(10pt)
  #only("3-")[Step 3 & 4: Divide and write as decimal]
  #only("3-")[$75/100 = 0.75$]

  #only("1")[
    #voiceover("Let's review this process with an example. We'll convert three-fourths to a decimal. First, we identify our fraction: three-fourths.")
  ]
  #only("2")[
    #voiceover("Next, we find an equivalent fraction with a denominator of 100. We can do this by multiplying both the numerator and denominator by 25. This gives us seventy-five over one hundred.")
  ]
  #only("3")[
    #voiceover("Finally, we perform the division and write the result as a decimal. Seventy-five divided by one hundred equals zero point seven five.")
  ]
]


