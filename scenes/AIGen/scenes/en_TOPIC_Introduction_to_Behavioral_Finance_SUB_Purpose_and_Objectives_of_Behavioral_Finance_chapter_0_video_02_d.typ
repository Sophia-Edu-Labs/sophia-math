#slide()[
#text(size: 30pt, weight: "bold")[Behavioral Finance]
#v(40pt)
#only("1-")[Studies how #text(weight: "bold")[psychological influences] and #text(weight: "bold")[biases] affect #text(weight: "bold")[financial behaviors] and #text(weight: "bold")[decisions]. 🧠💰]
#v(20pt)
#only("2-")[Examples: 📝]
#v(10pt)
