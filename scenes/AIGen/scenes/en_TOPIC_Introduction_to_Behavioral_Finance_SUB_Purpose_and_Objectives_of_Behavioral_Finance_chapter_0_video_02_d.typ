#v(10pt)
#only("5-")[- Herd behavior 🐑]
#only("1")[#voiceover("Behavioral Finance is a field that studies how psychological influences and biases affect financial behaviors and decisions.")]
#only("2")[#voiceover("Some examples of such psychological biases include:")]
#only("3")[#voiceover("Overconfidence bias, where people overestimate their abilities and knowledge.")]
#only("4")[#voiceover("Loss aversion, where people tend to prefer avoiding losses to acquiring equivalent gains.")]
#only("5")[#voiceover("And herd behavior, where people tend to mimic the actions of a larger group.")]
]

#slide()[
#text(size: 30pt, weight: "bold")[Traditional vs Behavioral Finance]
#v(40pt)
#only("1-")[Traditional Finance: 📈]
#v(10pt)
#only("2-")[- Assumes investors are #text(weight: "bold")[rational] 🤖]
#v(10pt)
#only("3-")[- Focuses on #text(weight: "bold")[market efficiency] 📊]
#v(40pt)
#only("4-")[Behavioral Finance: 🧠]
#v(10pt)
#only("5-")[- Recognizes investors can be #text(weight: "bold")[irrational] 😵]
#v(10pt)
#only("6-")[- Focuses on #text(weight: "bold")[psychological influences] 🎭]
#only("1")[#voiceover("Traditional finance assumes that investors are rational and focuses on market efficiency.")]
#only("2")[#voiceover("It assumes that investors make decisions based on available information and in a way that maximizes their utility.")]
#only("3")[#voiceover("And it believes that markets are efficient, meaning that asset prices reflect all available information.")]
#only("4")[#voiceover("In contrast, Behavioral Finance recognizes that investors can be irrational.")]
#only("5")[#voiceover("It acknowledges that investors are human and can make decisions based on emotions, biases, and heuristics.")]
#only("6")[#voiceover("Behavioral Finance focuses on these psychological influences and how they can lead to market anomalies and inefficiencies.")]
]

