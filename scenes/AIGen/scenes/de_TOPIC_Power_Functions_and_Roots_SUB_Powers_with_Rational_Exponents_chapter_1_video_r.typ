#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]

#slide()[
#text(size: 30pt, weight: "bold")[Rückblick: Vereinfachung von rationalen Exponenten]
#v(40pt)
#only("1-")[
- Umwandlung zwischen rationalem Exponenten und Radikalform 🔄
]
#only("1")[
#voiceover("In diesem Rückblick werden wir uns ansehen, wie man rationale Exponenten vereinfacht, indem man sie in Radikalform umwandelt und umgekehrt.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Rationaler Exponent zur Radikalform]
#v(40pt)
#only("1-")[
- $a^(m/n) = \sqrt[n]{a^m}$
]
#only("2-")[
- Beispiel: $16^(1/4) = \sqrt[4]{16} = 2$
]
#only("1")[
#voiceover("Um von der Form eines rationalen Exponenten zur Radikalform zu wechseln, verwenden wir die Formel a hoch m durch n gleich die n-te Wurzel von a hoch m.")
]
#only("2")[
#voiceover("Zum Beispiel, 16 hoch ein Viertel entspricht der vierten Wurzel von 16, was sich zu 2 vereinfacht.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Radikalform zum rationalen Exponenten]
#v(40pt)
#only("1-")[
- $\sqrt[n]{a} = a^(1/n)$
]
#only("2-")[
- Beispiel: $\sqrt[3]{27} = 27^(1/3) = 3$
]
#only("1")[
#voiceover("Um von der Radikalform zur Form eines rationalen Exponenten zu wechseln, verwenden wir die Formel die n-te Wurzel von a gleich a hoch 1 durch n.")
]
#only("2")[
#voiceover("Zum Beispiel, die dritte Wurzel von 27 entspricht 27 hoch ein Drittel, was sich zu 3 vereinfacht.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Ausdrücke vereinfachen]
#v(40pt)
#only("1-")[
- In die Form umwandeln, die den Ausdruck vereinfacht
]
#only("2-")[
- Beispiel: $(27^(1/3))^2 = (\sqrt[3]{27})^2 = 3^2 = 9$
]
#only("1")[
#voiceover("Beim Vereinfachen von Ausdrücken mit rationalen Exponenten wähle die Form, die die Vereinfachung erleichtert.")
]
#only("2")[
#voiceover("Zum Beispiel, um 27 hoch ein Drittel, alles zum Quadrat zu vereinfachen, können wir es zuerst in die Radikalform umwandeln, die dritte Wurzel von 27, dann quadrieren, um 3 zum Quadrat zu erhalten, was 9 ergibt.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Zusammenfassung]
#v(40pt)
#only("1-")[
- Rationaler Exponent zur Radikalform: $a^(m/n) = \sqrt[n]{a^m}$ 📏
]
#only("2-")[
- Radikalform zum rationalen Exponenten: $\sqrt[n]{a} = a^(1/n)$ 📐
]
#only("3-")[
- Vereinfache, indem Du die bequemere Form wählst 🎯
]
#only("1")[
#voiceover("Zusammenfassend können wir von der Form eines rationalen Exponenten zur Radikalform wechseln, indem wir die Formel a hoch m durch n gleich die n-te Wurzel von a hoch m verwenden.")
]
#only("2")[
#voiceover("Wir können von der Radikalform zur Form eines rationalen Exponenten wechseln, indem wir die Formel die n-te Wurzel von a gleich a hoch 1 durch n verwenden.")
]
#only("3")[
#voiceover("Beim Vereinfachen von Ausdrücken wähle die Form, die die Vereinfachung erleichtert. Übe diese Umwandlungen, um das Vereinfachen von rationalen Exponenten zu meistern!")
]
]