#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
  #text(size: 30pt, weight: "bold")[Brüche Subtrahieren]
  #v(40pt)

  #only("1-")[Übung: Subtrahiere 1/3 von 5/6]
  #v(20pt)

  #only("2-")[Schritt 1: Finde einen gemeinsamen Nenner]
  #v(10pt)
  #only("3-")[$ 5/6 - 1/3 = 5/6 - 2/6 $]

  #only("1")[
    #voiceover("Großartige Arbeit bei der Lösung dieses Problems! Lass uns die Lösung Schritt für Schritt durchgehen.")
  ]

  #only("2")[
    #voiceover("Zuerst müssen wir einen gemeinsamen Nenner finden. Die Nenner sind 6 und 3.")
  ]

  #only("3")[
    #voiceover("Das kleinste gemeinsame Vielfache von 6 und 3 ist 6. Also lassen wir 5/6 wie es ist und wandeln 1/3 in einen gleichwertigen Bruch mit dem Nenner 6 um. Wir multiplizieren sowohl den Zähler als auch den Nenner mit 2 und erhalten 2/6.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Die Subtraktion durchführen]
  #v(40pt)

  #only("1-")[Schritt 2: Zähler subtrahieren]
  #v(10pt)
  #only("2-")[$ 5/6 - 2/6 = 3/6 $]
  #v(20pt)
  #only("3-")[Schritt 3: Falls möglich, vereinfachen]
  #v(10pt)
  #only("4-")[$ 3/6 = 1/2 $]

  #only("1")[
    #voiceover("Jetzt, da wir einen gemeinsamen Nenner haben, können wir die Zähler subtrahieren.")
  ]

  #only("2")[
    #voiceover("5 minus 2 ergibt 3, also ist unser Ergebnis 3/6.")
  ]

  #only("3")[
    #voiceover("Schließlich überprüfen wir, ob wir unser Ergebnis vereinfachen können.")
  ]

  #only("4")[
    #voiceover("3 und 6 haben einen gemeinsamen Faktor von 3. Wenn wir sowohl den Zähler als auch den Nenner durch 3 teilen, erhalten wir 1/2 als unser endgültiges, vereinfachtes Ergebnis.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Endgültige Antwort]
  #v(40pt)

  #only("1-")[$ 5/6 - 1/3 = 1/2 $]
  #v(20pt)
  #only("2-")[Denke daran:
    - Finde einen gemeinsamen Nenner
    - Subtrahiere die Zähler
    - Vereinfache, falls möglich]

  #only("1")[
    #voiceover("Also, unsere endgültige Antwort ist 1/2. Fünf Sechstel minus ein Drittel ergibt ein Halb.")
  ]

  #only("2")[
    #voiceover("Um zusammenzufassen: Wenn du Brüche subtrahierst, denke an diese wichtigen Schritte: Zuerst finde einen gemeinsamen Nenner. Dann subtrahiere die Zähler und behalte den Nenner bei. Schließlich vereinfache dein Ergebnis, falls möglich. Großartige Arbeit bei der Lösung dieses Problems!")
  ]
]