]

#slide()[
#text(size: 30pt, weight: "bold")[Blutdruckmessung]
#v(40pt)
#only("1-")[- Gemessen in mmHg (Millimeter Quecksilbersäule) 🩺]
#v(20pt)
#only("2-")[- Reflektiert die Höhe der Quecksilbersäule, die durch den Blutdruck ausgeglichen wird 📏]
#only("1")[
#voiceover("Blutdruck wird üblicherweise in Millimeter Quecksilbersäule gemessen, abgekürzt als mmHg.")
]
#only("2")[
#voiceover("Diese Einheit spiegelt die Höhe einer Quecksilbersäule wider, die durch den Druck des Blutes ausgeglichen wird.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Sphygmomanometer]
#v(40pt)
#only("1-")[- Gerät zur Messung des Blutdrucks 📏]
#v(20pt)
#only("2-")[- Besteht aus einer aufblasbaren Manschette, einer Pumpe und einem Quecksilbermanometer 🩺]
#only("1")[
#voiceover("Blutdruck wird typischerweise mit einem Gerät namens Sphygmomanometer gemessen.")
]
#only("2")[
#voiceover("Ein Sphygmomanometer besteht aus einer aufblasbaren Manschette, die um den Arm gelegt wird, einer Pumpe zum Aufblasen der Manschette und einem Quecksilbermanometer zur Druckmessung.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Messvorgang]
#v(40pt)
#only("1-")[- Manschette wird aufgepumpt, um den Blutfluss in der Arterie zu stoppen 🎈]
#v(20pt)
#only("2-")[- Während die Manschette entleert wird, beginnt das Blut wieder zu fließen 🩸]
#v(20pt)
#only("3-")[- Systolischer Druck: Druck, wenn das Blut zu fließen beginnt 📈]
#v(20pt)
#only("4-")[- Diastolischer Druck: Druck, wenn das Blut frei fließt 📉]
#only("1")[
#voiceover("Um den Blutdruck zu messen, wird die Manschette auf einen Druck aufgepumpt, der hoch genug ist, um den Blutfluss in der Hauptarterie des Arms zu stoppen.")
]
#only("2")[
#voiceover("Während die Manschette allmählich entleert wird, beginnt das Blut wieder zu fließen.")
]
#only("3")[
#voiceover("Der Druck, bei dem das Blut zu fließen beginnt, wird als systolischer Druck bezeichnet.")
]
#only("4")[
#voiceover("Der Druck, bei dem das Blut frei fließt, wird als diastolischer Druck bezeichnet.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Manometer ablesen]
#v(40pt)
#only("1-")[- Höhe der Quecksilbersäule zeigt den Druck an 📏]
#v(20pt)
#only("2-")[- Gemessen in Millimetern (mm) 📐]
#v(20pt)
#only("3-")[- Beispiel: 120/80 mmHg = systolischer/diastolischer Druck 🩺]
#only("1")[
#voiceover("Die Höhe der Quecksilbersäule im Manometer zeigt direkt den Blutdruck an.")
]
#only("2")[
#voiceover("Diese Höhe wird in Millimetern gemessen.")
]
#only("3")[
#voiceover("Ein typischer Blutdruckwert könnte 120 zu 80 mmHg sein, wobei 120 der systolische Druck und 80 der diastolische Druck ist.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Zusammenfassung]
#v(40pt)
#only("1-")[- Blutdruck gemessen in mmHg 🩺]
#v(20pt)
#only("2-")[- Reflektiert die Höhe der Quecksilbersäule, die durch den Blutdruck ausgeglichen wird 📏]
#v(20pt)
#only("3-")[- Gemessen mit einem Sphygmomanometer 📐]
#v(20pt)
#only("4-")[- Systolischer und diastolischer Druck werden aufgezeichnet 📈📉]
#only("1")[
#voiceover("Zusammenfassend wird der Blutdruck in Millimeter Quecksilbersäule, oder mmHg, gemessen.")
]
#only("2")[
#voiceover("Diese Einheit spiegelt die Höhe einer Quecksilbersäule wider, die durch den Druck des Blutes ausgeglichen wird.")
]
#only("3")[
#voiceover("Der Blutdruck wird mit einem Gerät namens Sphygmomanometer gemessen.")
]
#only("4")[
#voiceover("Die Messung erfasst den systolischen Druck, wenn das Blut zu fließen beginnt, und den diastolischen Druck, wenn das Blut frei fließt.")
