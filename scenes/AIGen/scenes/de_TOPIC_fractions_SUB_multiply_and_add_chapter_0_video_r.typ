#slide()[
  #text(size: 30pt, weight: "bold")[Brüche multiplizieren: Der Prozess]
  #v(40pt)
  #only("1-")[1️⃣ Zähler multiplizieren]
  #v(20pt)
  #only("2-")[2️⃣ Nenner multiplizieren]
  #v(20pt)
  #only("3-")[3️⃣ Wenn möglich, vereinfachen]
  #v(40pt)
  #only("4-")[
    #align(center)[
      $ (a/b) dot (c/d) = (a dot c)/(b dot d) $
    ]
  ]
  
  #only("1")[
    #voiceover("Der Prozess des Multiplizierens von Brüchen ist einfach. Zuerst multiplizieren wir die Zähler.")
  ]
  #only("2")[
    #voiceover("Dann multiplizieren wir die Nenner.")
  ]
  #only("3")[
    #voiceover("Schließlich vereinfachen wir das Ergebnis, wenn möglich.")
  ]
  #only("4")[
    #voiceover("Dieser Prozess kann in einer einfachen Formel zusammengefasst werden: a durch b mal c durch d gleich a mal c durch b mal d.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Beispiel: Brüche multiplizieren]
  #v(40pt)
  #only("1-")[
    #align(center)[
      $ (2/3) dot (3/4) = ? $
    ]
  ]
  #v(20pt)
  #only("2-")[1️⃣ Zähler multiplizieren: $2 dot 3 = 6$]
  #v(20pt)
  #only("3-")[2️⃣ Nenner multiplizieren: $3 dot 4 = 12$]
  #v(20pt)
  #only("4-")[3️⃣ Kombinieren: $(2/3) dot (3/4) = 6/12$]
  #v(20pt)
  #only("5-")[4️⃣ Vereinfachen: $6/12 = 1/2$]
  
  #only("1")[
    #voiceover("Lass uns ein Beispiel durchgehen. Angenommen, wir wollen zwei Drittel mit drei Vierteln multiplizieren.")
  ]
  #only("2")[
    #voiceover("Zuerst multiplizieren wir die Zähler: 2 mal 3 gleich 6.")
  ]
  #only("3")[
    #voiceover("Dann multiplizieren wir die Nenner: 3 mal 4 gleich 12.")
  ]
  #only("4")[
    #voiceover("Kombiniert ergibt das 6 durch 12.")
  ]
  #only("5")[
    #voiceover("Schließlich können wir das auf ein Halb vereinfachen.")
  ]
]


