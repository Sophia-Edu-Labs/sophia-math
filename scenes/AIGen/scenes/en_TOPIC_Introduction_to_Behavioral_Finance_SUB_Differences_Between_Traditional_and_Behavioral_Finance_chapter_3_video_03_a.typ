#slide()[
#text(size: 30pt, weight: "bold")[Market Efficiency]
#v(40pt)
#only("1-")[- In an efficient market, asset prices fully reflect all available information 📊]
#v(20pt)
#only("2-")[- New information is quickly incorporated into prices 🏃‍♂️💨]
#v(20pt)
#only("3-")[- It's difficult to find undervalued or overvalued assets 🔍]
#v(20pt)
#only("4-")[- Consistently outperforming the market is nearly impossible 🚫📈]
#only("1")[#voiceover("In an efficient market, asset prices fully reflect all available information at any given time.")]
#only("2")[#voiceover("When new information becomes available, it is quickly incorporated into the asset prices.")]
#only("3")[#voiceover("Because of this, it's difficult to find assets that are undervalued or overvalued relative to their fair value.")]
#only("4")[#voiceover("As a result, consistently achieving returns higher than the market average is nearly impossible.")]
]

#slide()[
