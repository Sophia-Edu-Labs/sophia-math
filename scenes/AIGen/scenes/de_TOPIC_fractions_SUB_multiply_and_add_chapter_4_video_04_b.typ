#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
#only("1")[
#voiceover("Leider war das nicht ganz richtig. Lass uns die Lösung Schritt für Schritt durchgehen, um zu sehen, wie wir zur richtigen Antwort kommen.")
]

#text(size: 30pt, weight: "bold")[Änderung des Bruchnenners]

#v(40pt)

#only("2-")[#text()[Ursprünglicher Bruch: $4/7$]]
#v(10pt)
#only("3-")[#text()[Zielnenner: $14$]]

#only("2")[
#voiceover("Wir beginnen mit dem ursprünglichen Bruch, vier Siebtel.")
]

#only("3")[
#voiceover("Unser Ziel ist es, diesen Bruch in einen äquivalenten Bruch mit einem Nenner von vierzehn zu ändern.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Den Multiplikator finden]

#v(40pt)

#only("1-")[#text()[Zielnenner ÷ Ursprünglicher Nenner]]
#v(10pt)
#only("2-")[#text()[$14 ÷ 7 = 2$]]

#only("1")[
#voiceover("Um die Zahl zu finden, mit der wir sowohl den Zähler als auch den Nenner multiplizieren müssen, teilen wir den Zielnenner durch den ursprünglichen Nenner.")
]

#only("2")[
#voiceover("Vierzehn geteilt durch sieben ergibt zwei. Das bedeutet, wir müssen sowohl den Zähler als auch den Nenner mit zwei multiplizieren.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Den Bruch multiplizieren]

#v(40pt)

#only("1-")[#text()[$4/7 × 2/2$]]
#v(10pt)
#only("2-")[#text()[$= (4 × 2) / (7 × 2)$]]
#v(10pt)
#only("3-")[#text()[$= 8/14$]]

#only("1")[
#voiceover("Jetzt multiplizieren wir unseren ursprünglichen Bruch, vier Siebtel, mit zwei Halben. Denke daran, dass das Multiplizieren mit zwei Halben dasselbe ist wie das Multiplizieren mit eins, sodass sich der Wert unseres Bruchs nicht ändert.")
]

#only("2")[
#voiceover("Das ergibt vier mal zwei im Zähler und sieben mal zwei im Nenner.")
]

#only("3")[
#voiceover("Wenn wir das vereinfachen, erhalten wir acht Vierzehntel, was unsere endgültige Antwort ist.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Überprüfung]

#v(40pt)

#only("1-")[#text()[Ursprünglicher Bruch: $4/7 = 0.571428...$]]
#v(10pt)
#only("2-")[#text()[Neuer Bruch: $8/14 = 0.571428...$]]

#only("1")[
#voiceover("Um unsere Antwort zu überprüfen, können wir beide Brüche in Dezimalzahlen umwandeln. Der ursprüngliche Bruch, vier Siebtel, ist ungefähr null Komma fünf sieben eins vier zwei acht.")
]

#only("2")[
#voiceover("Unser neuer Bruch, acht Vierzehntel, ergibt ebenfalls null Komma fünf sieben eins vier zwei acht. Dies bestätigt, dass wir einen äquivalenten Bruch mit dem gewünschten Nenner gefunden haben.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Wichtigste Erkenntnis]

#v(40pt)

#only("1-")[- Um den Nenner eines Bruchs zu ändern, multipliziere sowohl den Zähler als auch den Nenner mit derselben Zahl]
#v(10pt)
#only("2-")[- Diese Zahl ist: (Neuer Nenner) ÷ (Ursprünglicher Nenner)]

#only("1")[
#voiceover("Die wichtigste Erkenntnis hier ist, dass wir, um den Nenner eines Bruchs zu ändern und seinen Wert beizubehalten, sowohl den Zähler als auch den Nenner mit derselben Zahl multiplizieren müssen.")
]

#only("2")[
#voiceover("Diese Zahl finden wir, indem wir den neuen Nenner durch den ursprünglichen Nenner teilen. Denke daran, dass diese Methode für jeden Bruch und jeden neuen Nenner, den du ändern möchtest, funktioniert!")
]
]