#v(20pt)
#only("2-")[$ E = m dot g dot h $]
#only("2")[
#voiceover("Dies kann mit der Formel E gleich m mal g mal h berechnet werden, wobei E die potenzielle Energie, m die Massendurchflussrate, g die Erdbeschleunigung und h die Höhe ist.")
]
]

#slide()[
