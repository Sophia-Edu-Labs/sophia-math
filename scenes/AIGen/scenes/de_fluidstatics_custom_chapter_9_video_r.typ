#voiceover("Die theoretisch maximale Leistungsabgabe eines Wasserkraftwerks kann aus der potenziellen Energie bestimmt werden.")
]
#v(20pt)
#only("2-")[$ P = E / t $]
#only("2")[
#voiceover("Sie ist gleich der potenziellen Energie E geteilt durch die Zeit t.")
]
]

