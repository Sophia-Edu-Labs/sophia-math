#slide()[
#text(size: 30pt, weight: "bold")[Steps to Convert Complex Decimals to Fractions]
#v(40pt)
#only("1-")[- Step 1: Count the decimal places. 🔢]
#v(20pt)
#only("2-")[- Step 2: Remove the decimal point. ✂️]
#v(20pt)
#only("3-")[- Step 3: Divide by a power of ten. ➗]
#v(20pt)
#only("4-")[- Example: $0.375$ becomes $375/1000$.]
#only("1")[
#voiceover("First, count the number of decimal places in the decimal number.")
]
#only("2")[
#voiceover("Next, remove the decimal point.")
]
#only("3")[
#voiceover("Then, divide the resulting number by a one, followed by zeros. Add one zero for each decimal place.")
]
#only("4")[
#voiceover("For example, zero point three seven five becomes three hundred seventy-five over one thousand.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Example: Converting $0.375$ to a Fraction]
#v(40pt)
#only("1-")[- Step 1: Count the decimal places in $0.375$. There are 3 decimal places. 🔢]
#v(20pt)
#only("2-")[- Step 2: Remove the decimal point: $375$. ✂️]
#v(20pt)
#only("3-")[- Step 3: Divide by $10^3 = 1000$: $375/1000$. ➗]
#v(20pt)
#only("4-")[- Step 4: Simplify the fraction: $375/1000 = 3/8$.]
#only("1")[
#voiceover("Let's see an example. For zero point three seven five, count the decimal places: there are three.")
]
#only("2")[
#voiceover("Remove the decimal point to get three hundred seventy-five.")
]
#only("3")[
#voiceover("Then, divide three hundred seventy-five by one thousand, because there are three decimal places. So, three hundred seventy-five over one thousand.")
]
#only("4")[
#voiceover("Finally, simplify the fraction. Three hundred seventy-five over one thousand simplifies to three over eight.")
]
]


