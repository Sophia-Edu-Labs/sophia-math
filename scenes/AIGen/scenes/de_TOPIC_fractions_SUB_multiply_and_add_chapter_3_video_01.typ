#slide()[
  #text(size: 30pt, weight: "bold")[Brüche ändern: Gleicher Wert, anderes Aussehen]
  #v(40pt)

  #only("1-")[- Pizzastücke: 1/2 = 2/4 = 3/6 = 4/8 🍕]
  #v(20pt)
  #only("2-")[- Äquivalente Brüche: Gleicher Wert, anderes Aussehen]
  #v(20pt)
  #only("3-")[- Schlüssel: Zähler und Nenner mit derselben Zahl multiplizieren]
  #v(20pt)
  #only("4-")[- Beispiel: $1/2 = (1 dot 2)/(2 dot 2) = 2/4$]

  #only("1")[
    #voiceover("Stell dir vor, du teilst eine Pizza mit Freunden. Eine halbe Pizza kann in zwei Stücke, vier Stücke oder sogar sechs Stücke geschnitten werden - es ist immer noch die gleiche Menge Pizza! Genau das machen wir, wenn wir den Nenner eines Bruchs ändern.")
  ]
  #only("2")[
    #voiceover("Diese Brüche, die unterschiedlich aussehen, aber die gleiche Menge darstellen, nennt man äquivalente Brüche. Sie haben den gleichen Wert, nur ein anderes Aussehen.")
  ]
  #only("3")[
    #voiceover("Der Schlüssel zur Erstellung äquivalenter Brüche ist, sowohl den Zähler als auch den Nenner mit derselben Zahl zu multiplizieren.")
  ]
  #only("4")[
    #voiceover("Schauen wir uns ein Beispiel an. Wir können ein Halb in zwei Viertel ändern, indem wir sowohl den Zähler als auch den Nenner mit zwei multiplizieren. Eins mal zwei ist zwei, und zwei mal zwei ist vier. Also ist ein Halb gleich zwei Viertel.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Die magische Multiplikation]
  #v(40pt)

  #only("1-")[- Um den Nenner zu ändern: Mit einer Form von 1 multiplizieren]
  #v(20pt)
  #only("2-")[- Beispiel: Ändere 3/4 in Sechzehntel]
  #v(20pt)
  #only("3-")[- Schritt 1: Multiplikator finden $(16/4 = 4)$]
  #v(20pt)
  #only("4-")[- Schritt 2: Mit $4/4 = 1$ multiplizieren]
  #v(20pt)
  #only("5-")[- Ergebnis: $3/4 = (3 dot 4)/(4 dot 4) = 12/16$]

  #only("1")[
    #voiceover("Um den Nenner eines Bruchs zu ändern, multiplizieren wir ihn mit einer speziellen Form der Zahl eins. Das ändert den Wert des Bruchs nicht, aber es ändert sein Aussehen.")
  ]
  #only("2")[
    #voiceover("Angenommen, wir wollen drei Viertel in einen äquivalenten Bruch mit Sechzehnteln im Nenner ändern.")
  ]
  #only("3")[
    #voiceover("Zuerst müssen wir herausfinden, womit wir vier multiplizieren müssen, um sechzehn zu erhalten. Sechzehn geteilt durch vier ist vier, also multiplizieren wir mit vier.")
  ]
  #only("4")[
    #voiceover("Nun multiplizieren wir sowohl den Zähler als auch den Nenner mit vier durch vier, was eins ergibt. Das ändert den Wert des Bruchs nicht.")
  ]
  #only("5")[
    #voiceover("Also, drei Viertel mal vier Viertel ergibt zwölf Sechzehntel. Wir haben den Nenner geändert, ohne den Wert des Bruchs zu ändern!")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Zusammenfassung: Nenner ändern]
  #v(40pt)

  #only("1-")[- Äquivalente Brüche: Gleicher Wert, anderes Aussehen]
  #v(20pt)
  #only("2-")[- Methode: Zähler und Nenner mit derselben Zahl multiplizieren]
  #v(20pt)
  #only("3-")[- Schlüsselidee: Mit einer Form von 1 multiplizieren (n/n = 1)]
  #v(20pt)
  #only("4-")[- Denke daran: Wert bleibt gleich, nur das Aussehen ändert sich!]

  #only("1")[
    #voiceover("Lass uns zusammenfassen, was wir über das Ändern des Nenners von Brüchen gelernt haben.")
  ]
  #only("2")[
    #voiceover("Wir können äquivalente Brüche erstellen, indem wir sowohl den Zähler als auch den Nenner mit derselben Zahl multiplizieren.")
  ]
  #only("3")[
    #voiceover("Die Schlüsselidee ist, dass wir eigentlich mit einer speziellen Form der Zahl eins multiplizieren, wie vier Viertel oder drei Drittel.")
