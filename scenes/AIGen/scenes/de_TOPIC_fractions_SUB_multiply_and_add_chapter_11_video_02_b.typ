#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
  #text(size: 30pt, weight: "bold")[Brüche subtrahieren]
  #v(40pt)

  #only("1-")[Übung: Subtrahiere 3/10 von 7/10]
  #v(20pt)

  #only("2-")[Schritt 1: Identifiziere die Brüche]
  #v(10pt)
  #only("3-")[- Minuend: 7/10]
  #only("4-")[- Subtrahend: 3/10]

  #only("1")[
    #voiceover("Keine Sorge, wir gehen die Lösung Schritt für Schritt durch, um zu verstehen, wie wir Brüche subtrahieren.")
  ]

  #only("2")[
    #voiceover("Zuerst identifizieren wir das Problem. Wir müssen drei Zehntel von sieben Zehntel subtrahieren.")
  ]

  #only("3")[
    #voiceover("Der Minuend, also die Zahl, von der wir subtrahieren, ist sieben Zehntel.")
  ]

  #only("4")[
    #voiceover("Der Subtrahend, also die Zahl, die wir subtrahieren, ist drei Zehntel.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Der Subtraktionsprozess]
  #v(40pt)

  #only("1-")[Schritt 2: Überprüfe die Nenner]
  #v(10pt)
  #only("2-")[- Beide Brüche haben den Nenner 10]
  #only("3-")[- Es ist nicht notwendig, einen gemeinsamen Nenner zu finden]
  #v(20pt)
  #only("4-")[Schritt 3: Subtrahiere die Zähler]
  #v(10pt)
  #only("5-")[$ 7/10 - 3/10 = (7-3)/10 = 4/10 $]

  #only("1")[
    #voiceover("Nun schauen wir uns den Subtraktionsprozess an.")
  ]

  #only("2")[
    #voiceover("Zuerst überprüfen wir die Nenner. In diesem Fall haben beide Brüche den Nenner zehn.")
  ]

  #only("3")[
    #voiceover("Das ist großartig, denn es bedeutet, dass wir keinen gemeinsamen Nenner finden müssen. Wir können direkt subtrahieren.")
  ]

  #only("4")[
    #voiceover("Um Brüche mit demselben Nenner zu subtrahieren, subtrahieren wir einfach die Zähler und behalten den Nenner bei.")
  ]

  #only("5")[
    #voiceover("Also haben wir sieben Zehntel minus drei Zehntel, was sieben minus drei über zehn ergibt. Das gibt uns vier Zehntel.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Das Ergebnis vereinfachen]
  #v(40pt)

  #only("1-")[Schritt 4: Vereinfache, wenn möglich]
  #v(10pt)
  #only("2-")[$ 4/10 = 2/5 $]
  #v(20pt)
  #only("3-")[Endgültige Antwort: 4/10 oder 2/5]

  #only("1")[
    #voiceover("Unser letzter Schritt ist zu überprüfen, ob wir unser Ergebnis vereinfachen können.")
  ]

  #only("2")[
    #voiceover("Vier Zehntel können vereinfacht werden, indem wir sowohl den Zähler als auch den Nenner durch ihren größten gemeinsamen Teiler, der 2 ist, teilen. Das gibt uns zwei Fünftel.")
  ]

  #only("3")[
    #voiceover("Daher ist unsere endgültige Antwort vier Zehntel, was auch als zwei Fünftel geschrieben werden kann. Beide Formen sind korrekt!")
  ]
]