#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]

#slide()[
#only("1")[
#voiceover("Lass uns die wichtigsten Punkte der Hicks-Dekomposition zusammenfassen.")
]
#text(size: 30pt, weight: "bold")[Zusammenfassung der Hicks-Dekomposition]
// Der Titel "Zusammenfassung der Hicks-Dekomposition" wird auf dieser Folie angezeigt
#v(40pt)
#only("2")[
#voiceover("Die Hicks-Dekomposition trennt die Wirkung einer Preisänderung in zwei Komponenten: den Substitutionseffekt und den Einkommenseffekt, wobei der Nutzen konstant gehalten wird.")
]
#only("2-")[
- Trennt die Wirkung einer Preisänderung in:
  - Substitutionseffekt 🔄
  - Einkommenseffekt 💰
- Hält den Nutzen konstant 📈
]
// Die wichtigsten Punkte werden ab Folie 2 als Aufzählungspunkte angezeigt
]

#slide()[
#text(size: 30pt, weight: "bold")[Substitutionseffekt]
#v(40pt)
#only("1")[
#voiceover("Der Substitutionseffekt zeigt, wie sich der Konsum ändert, wenn sich der Preis ändert, wobei der Nutzen konstant bleibt.")
]
#only("1-")[
- Zeigt die Änderung des Konsums aufgrund einer Preisänderung 📉
- Hält den Nutzen konstant 📈
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Einkommenseffekt]
#v(40pt)
#only("1")[
#voiceover("Der Einkommenseffekt zeigt, wie sich der Konsum aufgrund einer Änderung des realen Einkommens nach Anpassung an den Substitutionseffekt ändert.")
]
#only("1-")[
- Zeigt die Änderung des Konsums aufgrund einer Änderung des realen Einkommens 💸
- Passt sich an den Substitutionseffekt an 🔄
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Grafische Darstellung]
#v(40pt)
#only("1")[
#voiceover("Die Hicks-Dekomposition kann grafisch dargestellt werden, indem Indifferenzkurven und Budgetbeschränkungen verwendet werden, um die Substitutions- und Einkommenseffekte zu zeigen.")
]
#only("1-")[
- Verwendet Indifferenzkurven 📈 und Budgetbeschränkungen 💰
- Zeigt Substitutions- und Einkommenseffekte visuell 📊
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Mathematische Darstellung]
#v(40pt)
#only("1")[
#voiceover("Die Hicks-Dekomposition verwendet kompensierte Nachfragefunktionen, um die Substitutions- und Einkommenseffekte einer Preisänderung mathematisch darzustellen.")
]
#only("1-")[
- Verwendet kompensierte Nachfragefunktionen $h(p, U)$ 📜
- Stellt Substitutions- und Einkommenseffekte mathematisch dar 🧮
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Wichtige Erkenntnisse]
#v(40pt)
#only("1")[
#voiceover("Zusammenfassend ist die Hicks-Dekomposition ein leistungsstarkes Werkzeug zur Analyse der Auswirkungen von Preisänderungen auf das Konsumverhalten.")
]
#only("2")[
#voiceover("Sie trennt die Substitutions- und Einkommenseffekte, hält den Nutzen konstant und kann sowohl grafisch als auch mathematisch dargestellt werden.")
]
#only("3")[
#voiceover("Das Verständnis der Hicks-Dekomposition ist entscheidend für Ökonomen und Analysten, die das Konsumverhalten und die Auswirkungen von Preisänderungen auf Märkte untersuchen.")
]
#only("1-")[
- Leistungsstarkes Werkzeug zur Analyse der Auswirkungen von Preisänderungen 🔍
]
#only("2-")[
- Trennt Substitutions- und Einkommenseffekte, hält den Nutzen konstant 📊
]
#only("3-")[
- Entscheidend für das Verständnis des Konsumverhaltens und der Marktauswirkungen 📈
]
// Die wichtigsten Erkenntnisse werden als Aufzählungspunkte angezeigt, wobei jeder Punkt auf einer separaten Folie zusammen mit dem entsprechenden Voiceover erscheint
]