#slide()[
#text(size: 30pt, weight: "bold")[Sunk Cost Fallacy]
#v(40pt)  
#only("1-")[The sunk cost fallacy is the tendency to continue an endeavor once an investment in money, effort, or time has been made. 💸]
#v(20pt)
#only("2-")[This can lead to irrational decisions, such as:]
#v(20pt)  
#only("3-")[- Continuing an unprofitable project 📉]
#v(10pt)
#only("4-")[- Holding onto a losing investment 📈🔻]
#v(10pt)
#only("5-")[- Spending more to justify past decisions 🧾💰]
  
#only("1")[#voiceover("The sunk cost fallacy is the tendency to continue an endeavor once an investment in money, effort, or time has been made.")]
#only("2")[#voiceover("This can lead to irrational decisions, such as:")]  
#only("3")[#voiceover("Continuing an unprofitable project,")]
#only("4")[#voiceover("Holding onto a losing investment,")]
#only("5")[#voiceover("And spending more to justify past decisions.")]
]

#slide()[
#text(size: 30pt, weight: "bold")[Example]
#v(40pt)
#only("1-")[Imagine you've invested \$1,000 in a stock. 📊]
#v(20pt)  
#only("2-")[The stock price has fallen and your investment is now worth only \$500. 📉]
#v(20pt)
#only("3-")[The sunk cost fallacy might lead you to hold the stock, hoping it will recover, rather than selling and investing elsewhere. 🤞]

