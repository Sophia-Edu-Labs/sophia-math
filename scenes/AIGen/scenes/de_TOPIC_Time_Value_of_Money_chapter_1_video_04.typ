#slide()[
#text(size: 30pt, weight: "bold")[Barwert (P V) 💰]
#v(40pt)
#only("1-")[- Aktueller Wert eines zukünftigen Betrags]
#v(20pt)
#only("2-")[- Abgezinst zu einem bestimmten Zinssatz]
#v(20pt)
#only("3-")[- Formel: $P V = F V / (1 + r)^n$]
#only("1")[
#voiceover("Der Barwert, oder P V, ist der aktuelle Wert eines zukünftigen Geldbetrags.")
]
#only("2")[
#voiceover("Dieser zukünftige Betrag wird zu einem bestimmten Zinssatz abgezinst, um seinen Barwert zu bestimmen.")
]
#only("3")[
#voiceover("Die Formel zur Berechnung des Barwerts lautet P V gleich F V geteilt durch die Größe eins plus r hoch n, wobei F V der zukünftige Wert, r der Zinssatz und n die Anzahl der Perioden ist.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Beispiel 📝]
#v(40pt)
#only("1-")[- Zukünftiger Wert: \$1,000]
#v(20pt)
#only("2-")[- Zinssatz: 5% pro Jahr]
#v(20pt)
#only("3-")[- Anzahl der Jahre: 3]
#v(20pt)
#only("4-")[- $P V = 1000 / (1 + 0.05)^3 = 863.84$]
#only("1")[
#voiceover("Betrachten wir ein Beispiel. Angenommen, Du hast einen zukünftigen Wert von 1.000 Dollar.")
]
#only("2")[
#voiceover("Der Zinssatz beträgt 5 Prozent pro Jahr.")
]
#only("3")[
#voiceover("Und die Anzahl der Jahre beträgt 3.")
]
#only("4")[
#voiceover("Mit der Formel können wir den Barwert berechnen als 1.000 Dollar geteilt durch die Größe eins plus 0,05 hoch 3. Dies ergibt einen Barwert von 863 Dollar und 84 Cent.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Bedeutung 🌟]
#v(40pt)
#only("1-")[- Vergleich von Werten über die Zeit]
#v(20pt)
#only("2-")[- Treffen von Investitionsentscheidungen]
#v(20pt)
#only("3-")[- Bestimmung von Darlehenszahlungen]
#only("1")[
#voiceover("Der Barwert ist wichtig, weil er uns ermöglicht, Werte zu verschiedenen Zeitpunkten zu vergleichen.")
]
#only("2")[
#voiceover("Er ist ein Schlüsselkonzept bei Investitionsentscheidungen, da er hilft zu bestimmen, ob eine zukünftige Rendite die anfängliche Investition wert ist.")
]
#only("3")[
#voiceover("Der Barwert wird auch zur Bestimmung von Darlehenszahlungen verwendet, da der Darlehensbetrag der Barwert der zukünftigen Zahlungen ist.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Zusammenfassung 📝]
#v(40pt)
#only("1-")[- Barwert (P V) = Aktueller Wert eines zukünftigen Betrags 💰]
#v(20pt)
