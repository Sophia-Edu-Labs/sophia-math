#only("2")[#voiceover("According to the Efficient Market Hypothesis:")]
#only("3")[#voiceover("Asset prices are believed to fully reflect all available information at any given time.")]
#only("4")[#voiceover("Because of this, it is considered impossible to consistently achieve returns greater than the market average.")]
