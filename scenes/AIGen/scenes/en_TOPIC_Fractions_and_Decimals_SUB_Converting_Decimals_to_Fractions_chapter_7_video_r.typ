#slide()[
#text(size: 30pt, weight: "bold")[Steps to Convert Decimals to Fractions]
#v(40pt)
#only("1-")[- Step 1: Count the decimal places. 🔢]
#only("2-")[- Step 2: Remove the decimal point. ✂️]
#only("3-")[- Step 3: Divide by a power of ten. ➗]
#only("4-")[- Example: $0.75$ becomes $75/100$.]
#only("1")[
#voiceover("First, count the number of decimal places in the decimal number.")
]
#only("2")[
#voiceover("Next, remove the decimal point.")
]
#only("3")[
#voiceover("Then, divide the resulting number by a one, followed by zeros. Add one zero for each decimal place.")
]
#only("4")[
#voiceover("For example, zero point seven five becomes seventy-five over one hundred.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Example: Converting $0.75$ to a Fraction]
#v(40pt)
#only("1-")[- Step 1: Count the decimal places in $0.75$. There are 2 decimal places. 🔢]
#v(20pt)
#only("2-")[- Step 2: Remove the decimal point: $75$. ✂️]
#v(20pt)
#only("3-")[- Step 3: Divide by $10^2 = 100$: $75/100$. ➗]
#only("1")[
#voiceover("Let's see an example. For zero point seven five, count the decimal places: there are two.")
]
#only("2")[
#voiceover("Remove the decimal point to get seventy-five.")
]
#only("3")[
#voiceover("Then, divide seventy-five by a hundred, because there are two decimal places. So, seventy-five over one hundred.")
]
]


