#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
#only("1")[
#voiceover("Großartige Arbeit! Du hast die richtige Antwort. Lass uns Schritt für Schritt die Lösung durchgehen, um zu verstehen, wie wir $11/5$ in eine Dezimalzahl umwandeln.")
]

#text(size: 30pt, weight: "bold")[Umwandlung von $11/5$ in eine Dezimalzahl]

#v(40pt)

#only("2-")[#text()[$11/5$]]
#only("2")[
#voiceover("Wir beginnen mit dem Bruch elf Fünftel.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Schritt 1: Beide Teile mit 2 multiplizieren]
#v(40pt)
#only("1-")[$ 11/5 = (11 × 2)/(5 × 2) = 22/10 $]
#v(20pt)
#only("2-")[💡 Das ändert den Wert des Bruchs nicht!]

#only("1")[
#voiceover("Unser erster Schritt ist, sowohl den Zähler als auch den Nenner mit 2 zu multiplizieren. Das ergibt zweiundzwanzig Zehntel.")
]
#only("2")[
#voiceover("Denke daran, dass das Multiplizieren beider Teile eines Bruchs mit derselben Zahl dessen Wert nicht ändert.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Schritt 2: Das Dezimalzeichen identifizieren]
#v(40pt)
#only("1-")[$ 22/10 = 2.2 $]
#v(20pt)
#only("2-")[🔍 Das Dezimalzeichen steht vor der letzten Ziffer]

#only("1")[
#voiceover("Nun können wir zweiundzwanzig Zehntel leicht in eine Dezimalzahl umwandeln. Es wird zu zwei Komma zwei.")
]
#only("2")[
#voiceover("Beachte, dass das Dezimalzeichen vor der letzten Ziffer von 22 steht.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Endgültige Antwort]
#v(40pt)
#only("1-")[$ 11/5 = 2.2 $]
#v(20pt)
#only("2-")[✅ $11/5$ entspricht $2.2$ in Dezimalform]

#only("1")[
#voiceover("Unsere endgültige Antwort lautet also, dass elf Fünftel gleich zwei Komma zwei in Dezimalform ist.")
]
#only("2")[
#voiceover("Gut gemacht! Du hast erfolgreich einen Bruch in eine Dezimalzahl umgewandelt, indem du beide Teile mit 2 multipliziert hast.")
]
]