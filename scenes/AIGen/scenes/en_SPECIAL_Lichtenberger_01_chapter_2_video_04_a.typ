#slide()[
#text(size: 30pt, weight: "bold")[Archimedes' Principle]

#v(40pt)

#only("1-")[- Buoyant force equals weight of displaced fluid]

#only("2-")[- Ice cube displaces its own weight in water]

#only("1")[
#voiceover("First, let's recall Archimedes' principle, which states that the buoyant force on an object is equal to the weight of the fluid displaced by the object.")
]

#only("2")[
#voiceover("In this case, the floating ice cube displaces a volume of water that has the same weight as the ice cube itself.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Ice Melting Process]

#v(40pt)

#only("1-")[🧊 Ice cube melts into water 💧]
// The melting process is shown from slide 1 onward

#only("2-")[- Volume of melted ice equals volume of displaced water]
// The key insight about the volumes is shown from slide 2 onward

#only("1")[
#voiceover("As the ice cube melts, it turns into water.")
]

#only("2")[
#voiceover("The volume of water produced by the melting ice is exactly equal to the volume of water that was originally displaced by the floating ice cube.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Water Level Unchanged]

#v(40pt)

#only("1-")[- Melted ice replaces displaced water]
// The replacement of displaced water is shown from slide 1 onward

#only("2-")[- No net change in water volume or level 🌊]
// The conclusion about the water level is shown from slide 2 onward

#only("1")[
#voiceover("The melted ice essentially 'fills in' the space that was previously occupied by the displaced water.")
]

#only("2")[
#voiceover("As a result, there is no net change in the total volume of water in the glass, and thus the water level remains the same after the ice cube melts.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Summary]

#v(40pt)

#only("1-")[- Ice cube displaces its weight in water 🧊]
// The key point about the ice cube displacing its weight is reiterated from slide 1 onward

#only("2-")[- Melted ice equals displaced water volume 💧]
// The key point about the melted ice volume is reiterated from slide 2 onward

#only("3-")[- Water level remains constant 🌊]
// The conclusion about the water level is reiterated from slide 3 onward

#only("1")[
#voiceover("To summarize, a floating ice cube displaces a volume of water equal to its own weight.")
]

#only("2")[
#voiceover("When the ice melts, it produces a volume of water identical to the volume it originally displaced.")
]

#only("3")[
#voiceover("Consequently, the water level in the glass remains unchanged throughout the melting process.")
