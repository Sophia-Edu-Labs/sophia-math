#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
#only("1")[
#voiceover("Keine Sorge, wir schauen uns die Lösung Schritt für Schritt gemeinsam an.")
]

#text(size: 30pt, weight: "bold")[Dezimalzahlen in Brüche umwandeln]

#v(40pt)

#only("2-")[#text()[$7.910$]]
// Die Dezimalzahl 7.910 wird ab Folie 2 angezeigt

#only("2")[
#voiceover("Wir haben die Dezimalzahl sieben Komma neun eins null gegeben.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Schritte zum Umwandeln von Dezimalzahlen in Brüche]

#v(40pt)

#only("1-")[- Schritt 1: Zähle die Dezimalstellen. 🔢]
#v(20pt)
#only("2-")[- Schritt 2: Entferne den Dezimalpunkt. ✂️]
#v(20pt)
#only("3-")[- Schritt 3: Teile durch eine Zehnerpotenz. ➗]
#v(20pt)
#only("4-")[- Schritt 4: Vereinfache den Bruch, falls möglich. 🔄]

#only("1")[
#voiceover("Bevor wir die Übung lösen, lass uns schnell die Schritte zum Umwandeln von Dezimalzahlen in Brüche durchgehen. Zuerst zählst Du die Anzahl der Dezimalstellen in der Dezimalzahl.")
]
#only("2")[
#voiceover("Als nächstes entfernst Du den Dezimalpunkt aus der Zahl.")
]
#only("3")[
#voiceover("Dann teilst Du die resultierende Zahl durch eine Eins, gefolgt von Nullen, wobei die Anzahl der Nullen der Anzahl der Dezimalstellen entspricht.")
]
#only("4")[
#voiceover("Schließlich vereinfachst Du den Bruch, falls möglich.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Beispiel: $7.910$ in einen Bruch umwandeln]

#v(40pt)

#only("1-")[- Schritt 1: 🔢 Zähle die Dezimalstellen in $7.910$. $arrow$ Es gibt 3 Dezimalstellen.]
#v(20pt)
#only("2-")[- Schritt 2: ✂️ Entferne den Dezimalpunkt: $arrow 7910$.]
#v(20pt)
#only("3-")[- Schritt 3: ➗ Teile durch $1000 arrow 7910/1000$.]
#v(20pt)
#only("4-")[- Schritt 4: 🔄 Vereinfache den Bruch: $arrow 791/100$.]

#only("1")[
#voiceover("Nun lass uns diese Schritte auf die Dezimalzahl sieben Komma neun eins null anwenden. Zuerst zählen wir die Dezimalstellen. Es gibt drei Dezimalstellen.")
]
#only("2")[
#voiceover("Als nächstes entfernen wir den Dezimalpunkt, was uns sieben tausend neunhundert zehn ergibt.")
]
#only("3")[
#voiceover("Dann teilen wir sieben tausend neunhundert zehn durch eine Eins, gefolgt von drei Nullen. Da sieben Komma neun eins null drei Dezimalstellen hat, teilen wir es durch eintausend. So erhalten wir sieben tausend neunhundert zehn durch eintausend.")
]
#only("4")[
#voiceover("Schließlich vereinfachen wir den Bruch, falls möglich. In diesem Fall vereinfacht sich sieben tausend neunhundert zehn durch eintausend zu siebenhundert einundneunzig durch hundert.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Endgültige Antwort]

#v(40pt)

#only("1-")[Der Bruch, der $7.910$ entspricht, ist $791/100$]

#only("1")[
#voiceover("Also, der Bruch, der sieben Komma neun eins null entspricht, ist siebenhundert einundneunzig durch hundert. Gut gemacht!")
]
]