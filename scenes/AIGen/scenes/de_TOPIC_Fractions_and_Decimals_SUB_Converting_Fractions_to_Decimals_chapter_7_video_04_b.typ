#slide()[
#only("1")[
#voiceover("Leider war das nicht korrekt. Lass uns gemeinsam die Lösung Schritt für Schritt durchgehen, um zu verstehen, wie wir drei Fünftel in eine Dezimalzahl umwandeln.")
]

#text(size: 30pt, weight: "bold")[Umwandlung von $3/5$ in eine Dezimalzahl]

#v(40pt)

#only("2-")[#text()[$3/5$]]
#only("2")[
#voiceover("Wir beginnen mit dem Bruch drei Fünftel.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Schritt 1: Multiplizieren mit 2]
#v(40pt)
#only("1-")[- Multipliziere sowohl Zähler als auch Nenner mit 2]
#v(20pt)
#only("2-")[$ 3/5 = (3 × 2)/(5 × 2) = 6/10 $]

#only("1")[
#voiceover("Der erste Schritt ist, sowohl den Zähler als auch den Nenner mit 2 zu multiplizieren. Dies ändert den Wert des Bruchs nicht, macht es aber einfacher, ihn in eine Dezimalzahl umzuwandeln.")
]
#only("2")[
#voiceover("Also, drei Fünftel entspricht drei mal zwei über fünf mal zwei, was sich zu sechs Zehntel vereinfacht.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Schritt 2: Bestimme die Dezimalzahl]
#v(40pt)
#only("1-")[- $6/10 = 0.6$]
#v(20pt)
#only("2-")[💡 Der Nenner 10 zeigt die Position des Dezimalpunkts an]

#only("1")[
#voiceover("Nun, sechs Zehntel ist ein Bruch, der leicht in eine Dezimalzahl umgewandelt werden kann. Es entspricht null Komma sechs.")
]
#only("2")[
#voiceover("Denke daran, wenn der Nenner 10 ist, können wir den Bruch leicht als Dezimalzahl schreiben, indem wir den Dezimalpunkt vor die letzte Ziffer des Zählers setzen.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Endgültige Antwort]
#v(40pt)
#only("1-")[$ 3/5 = 0.6 $]
#v(20pt)
#only("2-")[✅ Dezimaldarstellung: 0.6]

#only("1")[
#voiceover("Daher ist drei Fünftel als Dezimalzahl null Komma sechs.")
]
#only("2")[
#voiceover("Und da haben wir es! Wir haben erfolgreich drei Fünftel in seine Dezimaldarstellung von null Komma sechs umgewandelt.")
]
]


#slide()[
#text(size: 30pt, weight: "bold")[Zusammenfassung]
#v(40pt)
#only("1-")[- Begonnen mit $3/5$ 📊]
#v(20pt)
#only("2-")[- Multipliziert mit $2/2$ um $6/10$ zu erhalten ✖️]
#v(20pt)
#only("3-")[- Umgewandelt $6/10$ in $0.6$ 🔢]

#only("1")[
#voiceover("Zusammenfassend haben wir mit dem Bruch drei Fünftel begonnen.")
]
#only("2")[
#voiceover("Wir haben sowohl den Zähler als auch den Nenner mit zwei multipliziert, um sechs Zehntel zu erhalten.")
]
#only("3")[
#voiceover("Schließlich haben wir sechs Zehntel in seine Dezimalform null Komma sechs umgewandelt. Großartige Arbeit bei der Lösung dieses Problems!")
]
]