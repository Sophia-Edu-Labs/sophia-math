#slide()[
#text(size: 30pt, weight: "bold")[Hicks Decomposition 🎯]

#v(40pt)

#only("1-")[- Substitution effect: Change in consumption due to price change, keeping utility constant]
#only("2-")[- Income effect: Change in consumption due to change in real income, after adjusting for substitution effect]

#only("1")[
#voiceover("In Hicks Decomposition, the substitution effect shows how consumption changes when the price changes, keeping utility constant.")
]

#only("2")[
#voiceover("The income effect in Hicks Decomposition shows how consumption changes due to a change in real income, after adjusting for the substitution effect.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Slutsky Decomposition 💰]

#v(40pt)

#only("1-")[- Substitution effect: Change in consumption due to price change, keeping real income constant]
#only("2-")[- Income effect: Change in consumption due to change in purchasing power, after adjusting for substitution effect]

#only("1")[
#voiceover("In Slutsky Decomposition, the substitution effect shows how consumption changes when the price changes, keeping real income constant.")
]

#only("2")[
#voiceover("The income effect in Slutsky Decomposition shows how consumption changes due to a change in purchasing power, after adjusting for the substitution effect.")
]
]

