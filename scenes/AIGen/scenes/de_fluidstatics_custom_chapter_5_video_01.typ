#v(20pt)
#only("2-")[$ F_A = rho dot V dot g $]
#v(20pt)
#only("3-")[- $rho$ = Dichte des Meerwassers (1020 kg/m³)]
#v(20pt)
#only("4-")[- $V$ = Volumen des verdrängten Wassers (m³)]
#v(20pt)
#only("5-")[- $g$ = Erdbeschleunigung (9,81 m/s²)]
#only("1")[
#voiceover("Die Auftriebskraft, die einem Taucher hilft zu schweben, nimmt ab, wenn der Taucher abtaucht.")
]
#only("2")[
#voiceover("Diese Kraft kann mit der Formel F sub A gleich rho mal V mal g berechnet werden.")
]
#only("3")[
#voiceover("Auch hier steht rho für die Dichte des Meerwassers.")
]
#only("4")[
#voiceover("V ist das Volumen des vom Taucher verdrängten Wassers, das abnimmt, wenn der Taucher in der Tiefe komprimiert wird.")
]
#only("5")[
#voiceover("Und g ist die Erdbeschleunigung.")
]
]

