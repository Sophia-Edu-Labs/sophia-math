#slide()[
#text(size: 30pt, weight: "bold")[Druckveränderungen 📈]
#v(40pt)
#only("1-")[- Der Druck nimmt mit der Tiefe zu]
#v(20pt)
#only("2-")[$ p = rho dot g dot h $]
#v(20pt)
#only("3-")[- $rho$ = Dichte des Meerwassers (1020 kg/m³)]
#v(20pt)
#only("4-")[- $g$ = Erdbeschleunigung (9,81 m/s²)]
#v(20pt)
#only("5-")[- $h$ = Tiefe (m)]
#only("1")[
#voiceover("Wenn ein Taucher abtaucht, nimmt der Druck linear mit der Tiefe zu.")
]
#only("2")[
#voiceover("Dies kann mit der Formel p gleich rho mal g mal h berechnet werden.")
]
#only("3")[
#voiceover("Hierbei steht rho für die Dichte des Meerwassers, die etwa 1020 Kilogramm pro Kubikmeter beträgt.")
]
#only("4")[
#voiceover("g ist die Erdbeschleunigung, die 9,81 Meter pro Sekunde zum Quadrat beträgt.")
]
#only("5")[
#voiceover("Und h ist die Tiefe in Metern.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Auftriebsveränderungen 🎈]
#v(40pt)
