#slide()[
#text(size: 30pt, weight: "bold")[Steps to Convert Fractions to Decimals]
#v(40pt)
#only("1-")[- Step 1: Identify the numerator. 🧮]
#v(20pt)
#only("2-")[- Step 2: Place the decimal point before the second to last digit. ➕]
#v(20pt)
#only("3-")[- Example: $75/100$ becomes $0.75$.]
#only("1")[
#voiceover("First, identify the numerator of the fraction.")
]
#only("2")[
#voiceover("Next, place the decimal point before the second to last digit of the numerator.")
]
#only("3")[
#voiceover("For example, seventy-five over one hundred becomes zero point seventy-five.")
]
]


