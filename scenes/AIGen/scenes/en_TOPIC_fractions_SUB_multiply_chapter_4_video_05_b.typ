#v(40pt)

#only("1-")[- Find the GCD of 48 and 105]
#only("1")[
#voiceover("To simplify, we find the greatest common divisor of forty-eight and one hundred and five.")
]

#only("2-")[- GCD is 3]
#only("2")[
#voiceover("The greatest common divisor is three.")
]

#only("3-")[- Divide numerator and denominator by GCD: $48/3$ and $105/3$]
#only("3")[
#voiceover("We divide both the numerator and the denominator by three.")
]

#only("4-")[- Simplified result: $16/35$]
#only("4")[
#voiceover("This simplifies the fraction to sixteen over thirty-five.")
]
]


