#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
#only("1")[
#voiceover("Let's recap the key points about how behavioral finance criticizes the Efficient Market Hypothesis, or EMH.")
]
#text(size: 30pt, weight: "bold")[Behavioral Finance vs EMH]
// The title "Behavioral Finance vs EMH" is shown on this slide
#v(40pt)
#only("2")[
#voiceover("EMH is a cornerstone of traditional finance. It states that asset prices fully reflect all available information and that it's impossible to consistently achieve higher returns than the market average.")
]
#only("2-")[
- EMH: asset prices reflect all information 📈
- Impossible to consistently beat the market 🏆
]
// The key points about EMH are shown from slide 2 onward
#v(40pt)
#only("3")[
#voiceover("In contrast, behavioral finance argues that psychological biases and irrational behavior can lead to market inefficiencies.")
]
#only("3-")[
- Behavioral finance: psychological biases 🧠
- Irrational behavior can lead to inefficiencies 🤯
]
// The key points about behavioral finance are shown from slide 3 onward
]

#slide()[
#only("1")[
#voiceover("Let's look at some of the psychological biases that behavioral finance identifies.")
]
#text(size: 30pt, weight: "bold")[Psychological Biases]
// The title "Psychological Biases" is shown on this slide
#v(40pt)
#only("2")[
#voiceover("One example is overconfidence bias. This occurs when investors overestimate their knowledge or ability to predict market movements.")
]
#only("2-")[
- Overconfidence bias 😎
  - Overestimating knowledge or predictive ability
]
// Overconfidence bias is introduced from slide 2 onward
#v(40pt)
#only("3")[
#voiceover("Another example is loss aversion. This refers to the tendency of investors to prefer avoiding losses over acquiring equivalent gains.")
]
#only("3-")[
- Loss aversion 😱
  - Preference to avoid losses over acquiring gains
]
// Loss aversion is introduced from slide 3 onward
]

#slide()[
#only("1")[
#voiceover("These biases can lead to irrational behavior in the markets.")
]
#text(size: 30pt, weight: "bold")[Market Inefficiencies]
// The title "Market Inefficiencies" is shown on this slide
#v(40pt)
#only("2")[
#voiceover("Overconfidence can lead to excessive trading, as investors believe they can time the market.")
]
#only("2-")[
- Overconfidence ⟶ Excessive trading 📈📉
]
// The link between overconfidence and excessive trading is shown from slide 2 onward
#v(40pt)
#only("3")[
#voiceover("Loss aversion can cause investors to hold on to losing investments for too long, hoping to avoid realizing a loss.")
]
#only("3-")[
- Loss aversion ⟶ Holding losing investments 📉
]
// The link between loss aversion and holding losing investments is shown from slide 3 onward
#v(40pt)
#only("4")[
#voiceover("These behaviors can lead to market prices deviating from their fundamental values, creating inefficiencies that contradict the assumptions of EMH.")
]
#only("4-")[
- Irrational behavior ⟶ Market inefficiencies 🌋
]
// The link between irrational behavior and market inefficiencies is shown from slide 4 onward
]

#slide()[
#only("1")[
#voiceover("In summary, behavioral finance challenges the assumptions of EMH by highlighting the impact of psychological biases on investor behavior and market outcomes.")
]
#text(size: 30pt, weight: "bold")[Summary]
// The title "Summary" is shown on this slide
#v(40pt)
#only("2-")[
- EMH: markets are efficient 📈
- Behavioral finance: psychological biases affect markets 🧠
- Biases can lead to irrational behavior 🤯
- Irrational behavior ⟶ Market inefficiencies 🌋
]
// The summary points are shown from slide 2 onward
#only("2")[
#voiceover("EMH assumes markets are efficient, while behavioral finance argues that psychological biases affect markets.")
]
#only("3")[
#voiceover("These biases can lead to irrational behavior by investors.")
]
#only("4")[
#voiceover("And this irrational behavior can cause market inefficiencies, contradicting the assumptions of EMH.")
]
]