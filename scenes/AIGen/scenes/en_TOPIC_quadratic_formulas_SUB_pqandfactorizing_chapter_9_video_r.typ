#slide()[
#text(size: 30pt, weight: "bold")[Example: Solving by Factoring]
#v(20pt)
#only("1-")[Solve: $x^2 - 5x + 6 = 0$]
#v(10pt)
#only("2-")[Step 1: Factor the equation]
#only("2-")[$x^2 - 5x + 6 = (x - 2)(x - 3) = 0$]
#v(10pt)
#only("3-")[Step 2: Apply the zero product property]
#only("3-")[$x - 2 = 0$ or $x - 3 = 0$]
#v(10pt)
#only("4-")[Step 3: Solve each linear equation]
#only("4-")[$x = 2$ or $x = 3$]
#only("1")[
#voiceover("Let's solve the equation x squared minus 5x plus 6 equals zero using factoring.")
]
#only("2")[
#voiceover("First, we factor the left side of the equation. We get x minus 2 times x minus 3 equals zero.")
]
#only("3")[
#voiceover("Next, we apply the zero product property. This states that if the product of factors is zero, then one of the factors must be zero.")
]
#only("4")[
#voiceover("Finally, we solve each linear equation. We find that x equals 2 or x equals 3. These are our solutions.")
]
]


