#slide()[
#text(size: 30pt, weight: "bold")[Step-by-Step Calculation 🧩]
#v(40pt)
#only("1-")[- Example data set: $3, 7, 8, 5, 12$]
#only("2-")[- Step 1: Add the numbers: $3 + 7 + 8 + 5 + 12$]
#only("3-")[- Step 2: Sum = $35$]
#only("4-")[- Step 3: Count of numbers = $5$]
#only("5-")[- Step 4: Mean = $35 / 5$]
#only("6-")[- Result: Mean = $7$]
#only("1")[
#voiceover("Let's go through the steps to calculate the mean using an example data set: 3, 7, 8, 5, and 12.")
]
#only("2")[
#voiceover("Step 1: Add the numbers together. So we have 3 plus 7 plus 8 plus 5 plus 12.")
]
#only("3")[
#voiceover("Step 2: The sum of these numbers is 35.")
]
#only("4")[
#voiceover("Step 3: Count the number of values in the data set, which is 5.")
]
#only("5")[
#voiceover("Step 4: Divide the sum by the count of numbers. So, 35 divided by 5.")
]
#only("6")[
#voiceover("The result is 7. Therefore, the mean of this data set is 7.")
]
]


