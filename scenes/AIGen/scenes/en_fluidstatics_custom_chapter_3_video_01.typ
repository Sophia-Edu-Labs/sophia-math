#voiceover("A sphygmomanometer consists of an inflatable cuff that goes around the arm, a pump to inflate the cuff, and a mercury manometer to measure the pressure.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Measuring Process]
#v(40pt)
#only("1-")[- Cuff is inflated to stop blood flow in the artery 🎈]
#v(20pt)
#only("2-")[- As cuff deflates, blood starts flowing again 🩸]
#v(20pt)
#only("3-")[- Systolic pressure: pressure when blood starts flowing 📈]
#v(20pt)
#only("4-")[- Diastolic pressure: pressure when blood flows freely 📉]
#only("1")[
#voiceover("To measure blood pressure, the cuff is inflated to a pressure high enough to stop blood flow in the main artery of the arm.")
]
#only("2")[
#voiceover("As the cuff is gradually deflated, blood starts to flow again.")
]
#only("3")[
#voiceover("The pressure at which the blood starts to flow is called the systolic pressure.")
]
#only("4")[
#voiceover("The pressure at which the blood flows freely is called the diastolic pressure.")
]
]

#slide()[
#text(size: 30pt, weight: "bold")[Reading the Manometer]
#v(40pt)
#only("1-")[- Height of mercury column indicates pressure 📏]
#v(20pt)
