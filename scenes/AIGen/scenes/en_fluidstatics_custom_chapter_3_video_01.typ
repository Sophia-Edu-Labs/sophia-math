#v(20pt)
#only("3-")[- Example: 120/80 mmHg = systolic/diastolic pressure 🩺]
#only("1")[
#voiceover("The height of the mercury column in the manometer directly indicates the blood pressure.")
]
#only("2")[
#voiceover("This height is measured in millimeters.")
]
#only("3")[
#voiceover("A typical blood pressure reading might be 120 over 80 mmHg, where 120 is the systolic pressure and 80 is the diastolic pressure.")
]
]

