#slide()[
  #text(size: 30pt, weight: "bold")[Einführung in das Volumen von Quadern]
  #v(40pt)
  
  #only("1-")[📦 Stell dir vor, du packst eine Kiste...]
  #v(20pt)
  #only("2-")[🤔 Wie viel kann sie fassen?]
  #v(20pt)
  #only("3-")[📏 Wir müssen ihr Fassungsvermögen messen!]
  #v(20pt)
  #only("4-")[🧮 Hier kommt das Volumen ins Spiel!]

  #only("1")[
    #voiceover("Lass uns mit einem praktischen Szenario beginnen. Stell dir vor, du packst eine Kiste...")
  ]
  #only("2")[
    #voiceover("Du fragst dich vielleicht, wie viel diese Kiste fassen kann?")
  ]
  #only("3")[
    #voiceover("Um das zu beantworten, müssen wir ihr Fassungsvermögen messen.")
  ]
  #only("4")[
    #voiceover("Hier kommt das Konzept des Volumens ins Spiel. Das Volumen sagt uns, wie viel Platz ein Objekt einnimmt oder wie viel es enthalten kann.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Verständnis von Quadern]
  #v(40pt)
  
  #only("1-")[📏 Länge (l)]
  #v(20pt)
  #only("2-")[📐 Breite (w)]
  #v(20pt)
  #only("3-")[🏗️ Höhe (h)]
  #v(20pt)
  #only("4-")[🧊 Quader = 3D-Rechteck]

  #only("1")[
    #voiceover("Nun, lass uns auf eine bestimmte Form konzentrieren: den Quader. Ein Quader hat drei wichtige Dimensionen. Zuerst haben wir die Länge.")
  ]
  #only("2")[
    #voiceover("Als nächstes haben wir die Breite.")
  ]
  #only("3")[
    #voiceover("Und schließlich haben wir die Höhe.")
  ]
  #only("4")[
    #voiceover("Zusammen definieren diese drei Dimensionen einen Quader, den du dir als ein dreidimensionales Rechteck vorstellen kannst.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Volumenberechnung]
  #v(40pt)
  
  #only("1-")[🧮 Volumen = Länge × Breite × Höhe]
  #v(20pt)
  #only("2-")[📐 $V = l dot w dot h$]
  #v(20pt)
  #only("3-")[📦 Beispiel: $2"m" dot 3"m" dot 4"m" = 24"m"^3$]
  #v(20pt)
  #only("4-")[🎉 24 Kubikmeter Platz!]

  #only("1")[
    #voiceover("Um das Volumen eines Quaders zu berechnen, multiplizieren wir seine Länge, Breite und Höhe miteinander.")
  ]
  #only("2")[
    #voiceover("Wir können dies mathematisch ausdrücken als V gleich l mal w mal h, wobei V das Volumen ist, l die Länge, w die Breite und h die Höhe.")
  ]
  #only("3")[
    #voiceover("Schauen wir uns ein Beispiel an. Wenn wir einen Quader mit einer Länge von 2 Metern, einer Breite von 3 Metern und einer Höhe von 4 Metern haben, multiplizieren wir diese miteinander: 2 mal 3 mal 4, was 24 Kubikmeter ergibt.")
  ]
  #only("4")[
    #voiceover("Das bedeutet, unser Quader kann 24 Kubikmeter Platz fassen!")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Zusammenfassung]
  #v(40pt)
  
  #only("1-")[📦 Quader: 3D-Form mit Länge, Breite, Höhe]
  #v(20pt)
  #only("2-")[🧮 Volumen = Länge × Breite × Höhe]
  #v(20pt)
  #only("3-")[📏 $V = l dot w dot h$]
  #v(20pt)
  #only("4-")[🎓 Misst Fassungsvermögen oder eingenommenen Raum]

  #only("1")[
    #voiceover("Lass uns zusammenfassen, was wir gelernt haben. Ein Quader ist eine dreidimensionale Form, die durch ihre Länge, Breite und Höhe definiert wird.")
  ]
  #only("2")[
    #voiceover("Um sein Volumen zu berechnen, multiplizieren wir diese drei Dimensionen miteinander.")
  ]
  #only("3")[
    #voiceover("Wir drücken dies aus als V gleich l mal w mal h.")
  ]
  #only("4")[
    #voiceover("Denke daran, dass das Volumen misst, wie viel Platz ein Objekt einnimmt oder wie viel es enthalten kann. Dieses Konzept ist in vielen realen Anwendungen wichtig, vom Packen von Kisten bis hin zum Entwerfen von Gebäuden!")
  ]
]