#import "../sophiatheme.typ": *
#show: sophia-theme
#show figure.caption: it => [
#set text(size: 20pt)
#it.body
]


#slide()[
  #text(size: 30pt, weight: "bold")[Brüche subtrahieren]
  #v(40pt)

  #only("1-")[Übung: Subtrahiere $2/7$ von $5/7$]
  
  #only("1")[
    #voiceover("Keine Sorge, wir gehen die Lösung Schritt für Schritt durch, um zu verstehen, wie wir Brüche mit demselben Nenner subtrahieren.")
  ]

  #only("2-")[Schritt 1: Identifiziere die Brüche]
  #only("2-")[- Minuend: $5/7$]
  #only("3-")[- Subtrahend: $2/7$]

  #only("2")[
    #voiceover("Zuerst identifizieren wir unsere Brüche. Wir haben fünf Siebtel als unseren Minuend, das ist die Zahl, von der wir subtrahieren.")
  ]

  #only("3")[
    #voiceover("Und wir haben zwei Siebtel als unseren Subtrahend, das ist die Zahl, die wir subtrahieren.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Der Subtraktionsprozess]
  #v(40pt)

  #only("1-")[Schritt 2: Überprüfe die Nenner]
  #only("1-")[- Beide Brüche haben 7 als Nenner]
  #only("1-")[- Kein gemeinsamer Nenner erforderlich]

  #only("1")[
    #voiceover("Als nächstes überprüfen wir die Nenner. In diesem Fall haben beide Brüche bereits 7 als Nenner. Das macht unsere Subtraktion einfacher, da wir keinen gemeinsamen Nenner finden müssen.")
  ]

  #only("2-")[Schritt 3: Subtrahiere die Zähler]
  #only("2-")[$ 5/7 - 2/7 = (5-2)/7 $]

  #only("2")[
    #voiceover("Jetzt können wir einfach die Zähler subtrahieren, während wir den Nenner gleich lassen. Also haben wir fünf minus zwei Siebtel.")
  ]

  #only("3-")[Schritt 4: Vereinfache]
  #only("3-")[$ (5-2)/7 = 3/7 $]

  #only("3")[
    #voiceover("Lass uns das vereinfachen. Fünf minus zwei ergibt drei, also ist unsere endgültige Antwort drei Siebtel.")
  ]
]


#slide()[
  #text(size: 30pt, weight: "bold")[Endgültige Antwort und Erklärung]
  #v(40pt)

  #only("1-")[Antwort: $3/7$]

  #only("1")[
    #voiceover("Also, unsere endgültige Antwort ist drei Siebtel. Das ergibt Sinn, weil wir mit fünf Siebteln begonnen haben und zwei Siebtel weggenommen haben, was uns drei Siebtel übrig lässt.")
  ]

  #only("2-")[Wichtiger Punkt: Beim Subtrahieren von Brüchen mit demselben Nenner subtrahieren wir nur die Zähler und lassen den Nenner gleich.]

  #only("2")[
    #voiceover("Der wichtige Punkt, den man sich merken sollte, ist, dass wir beim Subtrahieren von Brüchen mit demselben Nenner nur die Zähler subtrahieren und den Nenner gleich lassen müssen. Das liegt daran, dass der Nenner die Größe jedes Teils repräsentiert, die sich während der Subtraktion nicht ändert.")
  ]

  #only("3")[
    #voiceover("Großartige Arbeit bei der Lösung dieses Problems! Übe mehr solcher Aufgaben, um sicherer im Subtrahieren von Brüchen zu werden.")
  ]
]