#text(size: 30pt, weight: "bold")[Ableitung der Exponentialfunktion]
#v(40pt)
#only("1-")[$(e^x)' = e^x$]

#only("2")[
  #voiceover("In Formeln: Die Ableitung von e hoch x ist gleich e hoch x.")
]

]

#slide()[
